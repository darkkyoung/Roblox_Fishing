          <string name="Source"><![CDATA[--!strict
return {
    silver = {kind = "fish", nameKey = "silver", rarity = "common", value = 20, basicYield = 1, premiumYield = 0, color = {166, 210, 216}},
    sunny = {kind = "fish", nameKey = "sunny", rarity = "uncommon", value = 40, basicYield = 2, premiumYield = 1, color = {255, 177, 64}},
    azure = {kind = "fish", nameKey = "azure", rarity = "rare", value = 80, basicYield = 3, premiumYield = 2, color = {74, 160, 255}},
    tideEgg = {kind = "egg", nameKey = "tideEgg", rarity = "rare", color = {181, 148, 255}},
    otter = {kind = "pet", nameKey = "otter", rarity = "common", biteMultiplier = 0.90, reelMultiplier = 1.05, color = {171, 124, 90}},
    fox = {kind = "pet", nameKey = "fox", rarity = "rare", biteMultiplier = 0.80, reelMultiplier = 1.12, color = {255, 164, 80}},
    dragon = {kind = "pet", nameKey = "dragon", rarity = "legendary", biteMultiplier = 0.65, reelMultiplier = 1.25, color = {182, 143, 255}},
}
