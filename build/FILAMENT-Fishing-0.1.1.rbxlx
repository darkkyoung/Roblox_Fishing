    UI = {CardPageSize = 24, HoldInterval = 0.15, ResultSeconds = 3.2, ToastSeconds = 3.5},
    Colors = {
        ink = {28, 52, 57}, panel = {246, 242, 224}, card = {255, 252, 240},
