      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Domain</string>
          <string name="Source"><![CDATA[-- Pure game rules. No remotes, Instances, yielding, or DataStore dependencies.
local Domain = {}
function Domain.new(config, catalog, util)
    local self = {}
    function self.default()
        return {schema = config.SchemaVersion, revision = 0, coins = config.StartingCoins,
            items = {}, feed = {basic = 0, premium = 0}, aquariumLevel = 1, equippedPet = false}
    end
    function self.valid(data)
        local function integer(v, minimum, maximum)
            return type(v) == "number" and v == v and v >= minimum and v <= maximum and v % 1 == 0
        end
        if type(data) ~= "table" or data.schema ~= config.SchemaVersion then return false end
        if not integer(data.coins,0,1e12) then return false end
        if type(data.items) ~= "table" or type(data.feed) ~= "table" or not config.Aquarium[data.aquariumLevel] then return false end
        if not integer(data.revision,0,1e12) then return false end
        for _, k in ipairs({"basic", "premium"}) do
            if not integer(data.feed[k],0,1e12) then return false end
        end
        for id, item in pairs(data.items) do
            if type(id) ~= "string" or type(item) ~= "table" or item.id ~= id or not catalog[item.species] then return false end
            if item.kind ~= catalog[item.species].kind then return false end
            if item.location ~= "bag" and item.location ~= "aquarium" then return false end
            if item.kind == "pet" and item.location ~= "bag" then return false end
            if not integer(item.obtainedAt,0,1e12) then return false end
            if item.kind == "egg" and not integer(item.seed,1,2147483646) then return false end
            if item.kind == "egg" and item.location == "aquarium" then
                if not integer(item.readyAt,0,1e12) or not integer(item.startedAt,0,item.readyAt) then return false end
                if not config.Feed[item.feedQuality] or not config.Aquarium[item.incubationLevel] then return false end
            end
        end
        if data.equippedPet then
            local pet = data.items[data.equippedPet]
            if not pet or pet.kind ~= "pet" then return false end
        end
        return true
    end
    function self.grant(data, species, id, seed, now)
        if util.count(data.items) >= config.InventoryLimit then return false, "full" end
        if data.items[id] or not catalog[species] then return false, "invalid" end
        local kind = catalog[species].kind
        data.items[id] = {id = id, species = species, kind = kind, location = "bag", obtainedAt = now,
            seed = kind == "egg" and seed or nil,
            growth = kind == "fish" and {stage = 0, experience = 0, evolutionVersion = 1} or nil}
        return true, "granted"
    end
    function self.occupied(data)
        local n = 0
        for _, item in pairs(data.items) do if item.location == "aquarium" then n += 1 end end
        return n
    end
    function self.weights(level, quality, seconds)
        local f = config.Feed[quality]
        local time = math.clamp(seconds / config.HatchSeconds, 0, 1)
        return {
            {id = "otter", weight = config.HatchWeights.common},
            {id = "fox", weight = config.HatchWeights.rare + (level-1)*config.HatchLevelBonus.rare + f.rare + time*config.HatchTimeBonus.rare},
            {id = "dragon", weight = config.HatchWeights.legendary + (level-1)*config.HatchLevelBonus.legendary + f.legendary + time*config.HatchTimeBonus.legendary},
        }
    end
    function self.apply(data, action, id, option, now)
        if action == "upgrade" then
            local cost = config.Aquarium[data.aquariumLevel].nextCost
            if cost == 0 then return false, "maxLevel" end
            if data.coins < cost then return false, "noCoins" end
            data.coins -= cost
            data.aquariumLevel += 1
            return true, "upgraded"
        end
        if action == "unequip" then
            if not data.equippedPet then return false, "invalid" end
            data.equippedPet = false
            return true, "unequipped"
        end
        local item = data.items[id]
        if not item then return false, "notOwned" end
        local definition = catalog[item.species]
        if action == "place" then
            if item.location ~= "bag" or item.kind == "pet" then return false, "stateError" end
            if self.occupied(data) >= config.Aquarium[data.aquariumLevel].capacity then return false, "tankFull" end
            if item.kind == "egg" then
                local quality = option or "none"
                if not config.Feed[quality] then return false, "invalid" end
                if quality ~= "none" then
                    if data.feed[quality] < 1 then return false, "noFeed" end
                    data.feed[quality] -= 1
                end
                item.startedAt = now
                item.readyAt = now + config.Feed[quality].duration
                item.feedQuality = quality
                item.incubationLevel = data.aquariumLevel -- snapshot; upgrades affect new incubations
            end
            item.location = "aquarium"
            return true, "placed"
        elseif action == "retrieve" then
            if item.kind ~= "fish" or item.location ~= "aquarium" then return false, "eggLocked" end
            item.location = "bag"
            return true, "retrieved"
        elseif action == "sell" or action == "craft" then
            if item.kind ~= "fish" or item.location ~= "bag" then return false, "retrieveFirst" end
            if action == "sell" then data.coins += definition.value
            else
                if option ~= "basic" and option ~= "premium" then return false, "invalid" end
                local amount = option == "basic" and definition.basicYield or definition.premiumYield
                if amount == 0 then return false, "needBetterFish" end
                data.feed[option] += amount
            end
            data.items[id] = nil
            return true, action == "sell" and "sold" or "crafted"
        elseif action == "equip" then
            if item.kind ~= "pet" then return false, "invalid" end
            data.equippedPet = id
            return true, "equipped"
        end
        return false, "invalid"
    end
    function self.hatch(data, now)
        local results = {}
        for id, egg in pairs(data.items) do
            if egg.kind == "egg" and egg.location == "aquarium" and now >= egg.readyAt then
                local species = util.roll(self.weights(egg.incubationLevel, egg.feedQuality, egg.readyAt - egg.startedAt), util.seedUnit(egg.seed))
                -- Same identity becomes a pet. Removing the egg and granting the pet is one transaction.
                data.items[id] = {id = id, kind = "pet", species = species, location = "bag", obtainedAt = now,
                    originEgg = egg.species, hatchedAt = egg.readyAt, incubation = {level = egg.incubationLevel, feed = egg.feedQuality}}
                table.insert(results, species)
            end
        end
        return results
    end
    function self.buffs(data)
        local pet = data.items[data.equippedPet]
        local d = pet and catalog[pet.species]
        return d and d.biteMultiplier or 1, d and d.reelMultiplier or 1
    end
    return self
end
return Domain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">FishingMachine</string>
          <string name="Source"><![CDATA[-- Pure server-authoritative state machine; replace this for Fishing V2.
local Machine = {}
function Machine.new(config)
    local self = {}
    function self.begin(now, waitSeconds, reelMultiplier)
        return {phase = "Charge", started = now, changedAt = now, progress = 0, taps = 0,
            waitSeconds = waitSeconds, reelMultiplier = reelMultiplier, lastTap = -100, heldUntil = 0, resisted = false}
    end
    function self.input(s, action, now)
        if action == "release" and s.phase == "Charge" then
            s.power = math.clamp((now - s.started) / config.ChargeSeconds, 0, 1)
            s.phase = "Flight"
            s.changedAt = now
            return true
        elseif action == "hold" and s.phase == "Reel" then
            s.heldUntil = now + config.HoldLease
        elseif action == "stopHold" then
            s.heldUntil = 0
        elseif action == "tap" and s.phase == "Resist" and now < s.deadline and now - s.lastTap >= config.MinTapInterval then
            s.lastTap = now
            s.taps += 1
            if s.taps >= config.ResistanceTaps then
                s.resisted = true
                s.phase = "Reel"
                s.changedAt = now
                s.heldUntil = 0
            end
        end
        return false
    end
    function self.step(s, now, dt)
        if s.phase == "Success" or s.phase == "Failed" then return end
        if now - s.started > config.SessionTimeout or (s.phase == "Charge" and now-s.started > config.MaxChargeSeconds) then
            s.phase = "Failed"
            return
        end
        if s.phase == "Flight" and now - s.changedAt >= config.FlightSeconds then
            s.phase = "Waiting"
            s.changedAt = now
        elseif s.phase == "Waiting" and now - s.changedAt >= s.waitSeconds then
            s.phase = "Reel"
            s.changedAt = now
        elseif s.phase == "Reel" then
            if now <= s.heldUntil then s.progress = math.min(1, s.progress + math.min(dt, 0.15)*config.ProgressPerSecond*s.reelMultiplier) end
            if not s.resisted and s.progress >= config.ResistanceAt then
                s.progress = config.ResistanceAt
                s.phase = "Resist"
                s.deadline = now + config.ResistanceSeconds
                s.changedAt = now
                s.heldUntil = 0
            elseif s.progress >= 1 then s.phase = "Success" end
        elseif s.phase == "Resist" and now >= s.deadline then
            s.phase = "Failed"
        end
    end
    return self
end
return Machine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[-- Dimensions relative to CoreUISafeInsets, not the physical screen.
local Layout = {}
function Layout.metrics(width, height, touch)
    local portrait = width < 620 and height >= width
    local compact = height < 430
    local panelWidth = math.min(940, width - 24)
    local panelHeight = math.min(700, height - 24)
    local split = not portrait and panelWidth >= 590
    local detailWidth = split and math.clamp(math.floor(panelWidth * .36), 238, 320) or panelWidth - 24
    local listWidth = split and panelWidth - detailWidth - 40 or panelWidth - 24
    local cols = math.max(2, math.floor(listWidth / (compact and 124 or 144)))
    local cardWidth = math.floor((listWidth - (cols-1)*10 - 8) / cols)
    local gaugeWidth = math.min(touch and 300 or 370, width - (touch and not portrait and 240 or 36))
    local gaugeHeight = compact and 72 or 86
    local gaugeBottom = touch and (portrait and 210 or 82) or 110
    local actionSize = 64
    local actionY = math.max(70, height - (portrait and 198 or 172))
    return {
        panelWidth=panelWidth, panelHeight=panelHeight, portrait=portrait, compact=compact,
        split=split, detailWidth=detailWidth, listWidth=listWidth, columns=cols, cardWidth=cardWidth,
        cardHeight=compact and 132 or 154, gaugeWidth=gaugeWidth, gaugeHeight=gaugeHeight,
        gaugeY=height-gaugeBottom-gaugeHeight, gaugeBottom=gaugeBottom,
        actionSize=actionSize, actionX=width-actionSize-18, actionY=actionY,
        previewHeight=compact and 112 or 166,
    }
end
function Layout.hud(width)
    return {title=width>=340, coins=width>=170, bagWidth=48}
end
return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Original layered primitive art, shared by the world and inventory ViewportFrames.
local Models={}
local function piece(model,name,size,pos,color,shape,rotation)
    local p=Instance.new(shape=="Wedge" and "WedgePart" or "Part")
    p.Name=name;p.Size=size;p.CFrame=CFrame.new(pos)*(rotation or CFrame.identity)
    p.Color=color;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
    p.Material=Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
    if shape and shape~="Wedge" then p.Shape=shape end
    p.Parent=model;return p
end
function Models.make(kind,species,rgb)
    local m=Instance.new("Model");m.Name=species
    local color=Color3.fromRGB(rgb[1],rgb[2],rgb[3])
    local cream=Color3.fromRGB(248,228,190)
    local dark=Color3.fromRGB(30,52,58)
    local root=piece(m,"Root",Vector3.new(.1,.1,.1),Vector3.zero,color);root.Transparency=1;m.PrimaryPart=root
    if kind=="fish" then
        local bodyColor=color:Lerp(Color3.fromRGB(61,124,137),.18)
        piece(m,"Body",Vector3.new(.92,1.12,2.25),Vector3.zero,bodyColor,Enum.PartType.Ball)
        piece(m,"Belly",Vector3.new(.78,.68,1.88),Vector3.new(0,-.24,-.07),color:Lerp(cream,.68),Enum.PartType.Ball)
        for _,side in ipairs({-1,1}) do
            piece(m,"TailLobe",Vector3.new(.18,.75,.9),Vector3.new(0,side*.3,1.35),bodyColor,"Wedge",CFrame.Angles(0,0,side==1 and 0 or math.pi))
            piece(m,"SideFin",Vector3.new(.5,.12,.64),Vector3.new(side*.48,-.06,.2),color:Lerp(cream,.25),"Wedge",CFrame.Angles(0,side*.4,side*.2))
            piece(m,"EyeWhite",Vector3.new(.18,.27,.28),Vector3.new(side*.4,.16,-.72),cream,Enum.PartType.Ball)
            piece(m,"Pupil",Vector3.new(.11,.15,.15),Vector3.new(side*.49,.18,-.76),dark,Enum.PartType.Ball)
            if species=="sunny" then
                for i=1,3 do piece(m,"PerchStripe",Vector3.new(.08,.58,.12),Vector3.new(side*.44,.06,-.25+i*.33),bodyColor:Lerp(dark,.3)) end
            elseif species=="azure" then
                piece(m,"GoldGill",Vector3.new(.08,.53,.16),Vector3.new(side*.46,0,-.4),Color3.fromRGB(224,190,108))
            end
        end
        piece(m,"Dorsal",Vector3.new(.15,.55,1),Vector3.new(0,.58,.17),bodyColor,"Wedge")
    elseif kind=="egg" then
        piece(m,"Shell",Vector3.new(1.55,2.05,1.55),Vector3.zero,color:Lerp(cream,.25),Enum.PartType.Ball)
        for i=1,5 do
            local a=i*2.4
            piece(m,"TideMark",Vector3.new(.3,.44,.14),Vector3.new(math.sin(a)*.65,(i%3-1)*.43,math.cos(a)*.66),Color3.fromRGB(104,182,178),Enum.PartType.Ball,CFrame.Angles(0,a,0))
        end
        piece(m,"ShellCrown",Vector3.new(.55,.3,.55),Vector3.new(0,.94,0),cream,Enum.PartType.Ball)
    else
        piece(m,"Body",Vector3.new(1.45,1.45,1.85),Vector3.zero,color,Enum.PartType.Ball)
        piece(m,"Chest",Vector3.new(1.04,1.08,.55),Vector3.new(0,-.04,-.73),cream,Enum.PartType.Ball)
        piece(m,"Head",Vector3.new(1.55,1.35,1.4),Vector3.new(0,.78,-.67),color,Enum.PartType.Ball)
        piece(m,"Muzzle",Vector3.new(.92,.54,.53),Vector3.new(0,.52,-1.32),cream,Enum.PartType.Ball)
        piece(m,"Nose",Vector3.new(.22,.16,.18),Vector3.new(0,.62,-1.61),dark,Enum.PartType.Ball)
        for _,side in ipairs({-1,1}) do
            piece(m,"Eye",Vector3.new(.18,.25,.13),Vector3.new(side*.46,.94,-1.27),dark,Enum.PartType.Ball)
            piece(m,"EyeShine",Vector3.new(.06,.07,.05),Vector3.new(side*.43,1.01,-1.34),Color3.new(1,1,1),Enum.PartType.Ball)
            piece(m,"Ear",Vector3.new(.49,species=="fox" and .98 or .54,.48),Vector3.new(side*.53,1.43,-.63),color,species=="fox" and "Wedge" or Enum.PartType.Ball)
            piece(m,"Paw",Vector3.new(.54,.44,.65),Vector3.new(side*.58,-.65,-.45),color:Lerp(cream,.3),Enum.PartType.Ball)
            if species=="dragon" then
                piece(m,"Wing",Vector3.new(1.5,.16,1.3),Vector3.new(side*1.24,.6,.25),Color3.fromRGB(112,201,187),"Wedge",CFrame.Angles(0,side*.25,side*.28))
                piece(m,"Horn",Vector3.new(.22,.65,.3),Vector3.new(side*.45,1.6,-.4),cream,"Wedge")
            end
        end
        piece(m,"Tail",Vector3.new(.68,.68,1.6),Vector3.new(0,.08,1.12),color,Enum.PartType.Ball,CFrame.Angles(.18,0,0))
        if species=="fox" then piece(m,"TailTip",Vector3.new(.55,.55,.65),Vector3.new(0,.22,1.8),cream,Enum.PartType.Ball) end
    end
    return m
end
return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Presentation</string>
          <string name="Source"><![CDATA[-- Pure view state and input contract. Cannot award items or advance catches.
local Presentation = {}
function Presentation.view(phase, equipped, atPier, modal, coreMenu)
    local hidden = modal or coreMenu
    return {
        hint = not hidden and equipped and phase == "Idle",
        gauge = not hidden and (phase == "Charge" or phase == "Reel" or phase == "Resist"),
        waiting = not hidden and (phase == "Flight" or phase == "Waiting" or phase == "Saving"),
        action = not hidden and equipped and ((phase == "Idle" and atPier) or phase == "Charge" or phase == "Reel" or phase == "Resist"),
        cancel = not hidden and (phase == "Charge" or phase == "Flight" or phase == "Waiting" or phase == "Reel" or phase == "Resist"),
        result = not hidden and (phase == "Success" or phase == "Failed"),
    }
end
function Presentation.press(phase, held)
    if held then return nil end
    if phase == "Idle" then return "start" end
    if phase == "Reel" then return "hold" end
    if phase == "Resist" then return "tap" end
    return nil
end
function Presentation.canDebug(isStudio, enabled)
    return isStudio == true and enabled == true
end
function Presentation.context(distanceShop, distanceCraft, distanceTank, radius)
    -- UX hint only. The server independently validates every operation.
    if distanceTank <= radius then return "aquarium" end
    if distanceShop <= radius then return "shop" end
    if distanceCraft <= radius then return "craft" end
    return "bag"
end
function Presentation.actions(item, context, equipped)
    if item.kind == "pet" then return {item.id == equipped and "unequip" or "equip"} end
    if item.location == "aquarium" then return item.kind == "fish" and context == "aquarium" and {"retrieve"} or {} end
    if context == "aquarium" then return {"place"} end
    if item.kind == "fish" and context == "shop" then return {"sell"} end
    if item.kind == "fish" and context == "craft" then return {"craftBasic", "craftPremium"} end
    return {}
end
return Presentation
]]></string>
        </Properties>
      </Item>
