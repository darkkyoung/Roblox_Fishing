      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Domain</string>
          <string name="Source"><![CDATA[-- Pure game rules. No remotes, Instances, yielding, or DataStore dependencies.
local Domain = {}
function Domain.new(config, catalog, util)
    local self = {}
    function self.default()
        return {schema = config.SchemaVersion, revision = 0, coins = config.StartingCoins,
            items = {}, feed = {basic = 0, premium = 0}, aquariumLevel = 1, equippedPet = false}
    end
    function self.valid(data)
        local function integer(v, minimum, maximum)
            return type(v) == "number" and v == v and v >= minimum and v <= maximum and v % 1 == 0
        end
        if type(data) ~= "table" or data.schema ~= config.SchemaVersion then return false end
        if not integer(data.coins,0,1e12) then return false end
        if type(data.items) ~= "table" or type(data.feed) ~= "table" or not config.Aquarium[data.aquariumLevel] then return false end
        if not integer(data.revision,0,1e12) then return false end
        for _, k in ipairs({"basic", "premium"}) do
            if not integer(data.feed[k],0,1e12) then return false end
        end
        for id, item in pairs(data.items) do
            if type(id) ~= "string" or type(item) ~= "table" or item.id ~= id or not catalog[item.species] then return false end
            if item.kind ~= catalog[item.species].kind then return false end
            if item.location ~= "bag" and item.location ~= "aquarium" then return false end
            if item.kind == "pet" and item.location ~= "bag" then return false end
            if not integer(item.obtainedAt,0,1e12) then return false end
            if item.kind == "egg" and not integer(item.seed,1,2147483646) then return false end
            if item.kind == "egg" and item.location == "aquarium" then
                if not integer(item.readyAt,0,1e12) or not integer(item.startedAt,0,item.readyAt) then return false end
                if not config.Feed[item.feedQuality] or not config.Aquarium[item.incubationLevel] then return false end
            end
        end
        if data.equippedPet then
            local pet = data.items[data.equippedPet]
            if not pet or pet.kind ~= "pet" then return false end
        end
        return true
    end
    function self.grant(data, species, id, seed, now)
        if util.count(data.items) >= config.InventoryLimit then return false, "full" end
        if data.items[id] or not catalog[species] then return false, "invalid" end
        local kind = catalog[species].kind
        data.items[id] = {id = id, species = species, kind = kind, location = "bag", obtainedAt = now,
            seed = kind == "egg" and seed or nil,
            growth = kind == "fish" and {stage = 0, experience = 0, evolutionVersion = 1} or nil}
        return true, "granted"
    end
    function self.occupied(data)
        local n = 0
        for _, item in pairs(data.items) do if item.location == "aquarium" then n += 1 end end
        return n
    end
    function self.weights(level, quality, seconds)
        local f = config.Feed[quality]
        local time = math.clamp(seconds / config.HatchSeconds, 0, 1)
        return {
            {id = "otter", weight = config.HatchWeights.common},
            {id = "fox", weight = config.HatchWeights.rare + (level-1)*config.HatchLevelBonus.rare + f.rare + time*config.HatchTimeBonus.rare},
            {id = "dragon", weight = config.HatchWeights.legendary + (level-1)*config.HatchLevelBonus.legendary + f.legendary + time*config.HatchTimeBonus.legendary},
        }
    end
    function self.apply(data, action, id, option, now)
        if action == "upgrade" then
            local cost = config.Aquarium[data.aquariumLevel].nextCost
            if cost == 0 then return false, "maxLevel" end
            if data.coins < cost then return false, "noCoins" end
            data.coins -= cost
            data.aquariumLevel += 1
            return true, "upgraded"
        end
        if action == "unequip" then
            if not data.equippedPet then return false, "invalid" end
            data.equippedPet = false
            return true, "unequipped"
        end
        local item = data.items[id]
        if not item then return false, "notOwned" end
        local definition = catalog[item.species]
        if action == "place" then
            if item.location ~= "bag" or item.kind == "pet" then return false, "stateError" end
            if self.occupied(data) >= config.Aquarium[data.aquariumLevel].capacity then return false, "tankFull" end
            if item.kind == "egg" then
                local quality = option or "none"
                if not config.Feed[quality] then return false, "invalid" end
                if quality ~= "none" then
                    if data.feed[quality] < 1 then return false, "noFeed" end
                    data.feed[quality] -= 1
                end
                item.startedAt = now
                item.readyAt = now + config.Feed[quality].duration
                item.feedQuality = quality
                item.incubationLevel = data.aquariumLevel -- snapshot; upgrades affect new incubations
            end
            item.location = "aquarium"
            return true, "placed"
        elseif action == "retrieve" then
            if item.kind ~= "fish" or item.location ~= "aquarium" then return false, "eggLocked" end
            item.location = "bag"
            return true, "retrieved"
        elseif action == "sell" or action == "craft" then
            if item.kind ~= "fish" or item.location ~= "bag" then return false, "retrieveFirst" end
            if action == "sell" then data.coins += definition.value
            else
                if option ~= "basic" and option ~= "premium" then return false, "invalid" end
                local amount = option == "basic" and definition.basicYield or definition.premiumYield
                if amount == 0 then return false, "needBetterFish" end
                data.feed[option] += amount
            end
            data.items[id] = nil
            return true, action == "sell" and "sold" or "crafted"
        elseif action == "equip" then
            if item.kind ~= "pet" then return false, "invalid" end
            data.equippedPet = id
            return true, "equipped"
        end
        return false, "invalid"
    end
    function self.hatch(data, now)
        local results = {}
        for id, egg in pairs(data.items) do
            if egg.kind == "egg" and egg.location == "aquarium" and now >= egg.readyAt then
                local species = util.roll(self.weights(egg.incubationLevel, egg.feedQuality, egg.readyAt - egg.startedAt), util.seedUnit(egg.seed))
                -- Same identity becomes a pet. Removing the egg and granting the pet is one transaction.
                data.items[id] = {id = id, kind = "pet", species = species, location = "bag", obtainedAt = now,
                    originEgg = egg.species, hatchedAt = egg.readyAt, incubation = {level = egg.incubationLevel, feed = egg.feedQuality}}
                table.insert(results, species)
            end
        end
        return results
    end
    function self.buffs(data)
        local pet = data.items[data.equippedPet]
        local d = pet and catalog[pet.species]
        return d and d.biteMultiplier or 1, d and d.reelMultiplier or 1
    end
    return self
end
return Domain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">FishingMachine</string>
          <string name="Source"><![CDATA[-- Pure server-authoritative state machine; replace this for Fishing V2.
local Machine = {}
function Machine.new(config)
    local self = {}
    function self.begin(now, waitSeconds, reelMultiplier)
        return {phase = "Charge", started = now, changedAt = now, progress = 0, taps = 0,
            waitSeconds = waitSeconds, reelMultiplier = reelMultiplier, lastTap = -100, heldUntil = 0, resisted = false}
    end
    function self.input(s, action, now)
        if action == "release" and s.phase == "Charge" then
            s.power = math.clamp((now - s.started) / config.ChargeSeconds, 0, 1)
            s.phase = "Flight"
            s.changedAt = now
            return true
        elseif action == "hold" and s.phase == "Reel" then
            s.heldUntil = now + config.HoldLease
        elseif action == "stopHold" then
            s.heldUntil = 0
        elseif action == "tap" and s.phase == "Resist" and now < s.deadline and now - s.lastTap >= config.MinTapInterval then
            s.lastTap = now
            s.taps += 1
            if s.taps >= config.ResistanceTaps then
                s.resisted = true
                s.phase = "Reel"
                s.changedAt = now
                s.heldUntil = 0
            end
        end
        return false
    end
    function self.step(s, now, dt)
        if s.phase == "Success" or s.phase == "Failed" then return end
        if now - s.started > config.SessionTimeout or (s.phase == "Charge" and now-s.started > config.MaxChargeSeconds) then
            s.phase = "Failed"
            return
        end
        if s.phase == "Flight" and now - s.changedAt >= config.FlightSeconds then
            s.phase = "Waiting"
            s.changedAt = now
        elseif s.phase == "Waiting" and now - s.changedAt >= s.waitSeconds then
            s.phase = "Reel"
            s.changedAt = now
        elseif s.phase == "Reel" then
            if now <= s.heldUntil then s.progress = math.min(1, s.progress + math.min(dt, 0.15)*config.ProgressPerSecond*s.reelMultiplier) end
            if not s.resisted and s.progress >= config.ResistanceAt then
                s.progress = config.ResistanceAt
                s.phase = "Resist"
                s.deadline = now + config.ResistanceSeconds
                s.changedAt = now
                s.heldUntil = 0
            elseif s.progress >= 1 then s.phase = "Success" end
        elseif s.phase == "Resist" and now >= s.deadline then
            s.phase = "Failed"
        end
    end
    return self
end
return Machine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[-- Shared arithmetic makes the UI's safe-area dimensions independently testable.
local Layout={}
function Layout.metrics(width,height)
    return {panelWidth=math.min(760,width-24),panelHeight=math.max(120,height-40),
        fishWidth=math.min(430,width-24),fishY=height<440 and 96 or 108,
        compact=height<440,cardWidth=math.min(760,width-24)-32}
end
return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Original primitive art. No external meshes, images, or marketplace assets.
local Models = {}
local function piece(model, name, size, position, color, shape)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Position = position
    p.Color = color
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Material = Enum.Material.SmoothPlastic
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    if shape then p.Shape = shape end
    p.Parent = model
    return p
end
function Models.make(kind, species, rgb)
    local m = Instance.new("Model")
    m.Name = species
    local color = Color3.fromRGB(rgb[1],rgb[2],rgb[3])
    local root = piece(m,"Root",Vector3.new(.2,.2,.2),Vector3.zero,color)
    root.Transparency = 1
    m.PrimaryPart = root
    if kind == "fish" then
        piece(m,"Body",Vector3.new(.9,1,2.2),Vector3.zero,color,Enum.PartType.Ball)
        piece(m,"Tail",Vector3.new(.25,1.3,.7),Vector3.new(0,0,1.3),color)
        piece(m,"Fin",Vector3.new(.18,.6,.8),Vector3.new(0,.5,.1),color)
        for _,x in ipairs({-.42,.42}) do piece(m,"Eye",Vector3.new(.16,.16,.16),Vector3.new(x,.16,-.7),Color3.new(.06,.1,.13),Enum.PartType.Ball) end
    elseif kind == "egg" then
        piece(m,"Shell",Vector3.new(1.6,2.1,1.6),Vector3.zero,color,Enum.PartType.Ball)
        for _,v in ipairs({Vector3.new(.6,.3,-.3),Vector3.new(-.35,-.3,-.65),Vector3.new(.1,.65,-.5)}) do
            piece(m,"Spot",Vector3.new(.45,.45,.22),v,Color3.fromRGB(246,231,167),Enum.PartType.Ball)
        end
    else
        piece(m,"Body",Vector3.new(1.6,1.4,1.8),Vector3.zero,color,Enum.PartType.Ball)
        piece(m,"Head",Vector3.new(1.5,1.3,1.3),Vector3.new(0,.65,-.7),color,Enum.PartType.Ball)
        piece(m,"Muzzle",Vector3.new(.85,.55,.45),Vector3.new(0,.4,-1.32),Color3.fromRGB(251,230,196),Enum.PartType.Ball)
        for _,x in ipairs({-.48,.48}) do
            piece(m,"Eye",Vector3.new(.17,.22,.15),Vector3.new(x,.8,-1.24),Color3.new(.07,.09,.13),Enum.PartType.Ball)
            piece(m,"Ear",Vector3.new(.45,species == "fox" and 1 or .5,.5),Vector3.new(x,1.35,-.6),color,Enum.PartType.Ball)
        end
        if species == "dragon" then
            for _,x in ipairs({-1.3,1.3}) do
                local wing = piece(m,"Wing",Vector3.new(1.7,.15,1.5),Vector3.new(x,.6,.2),Color3.fromRGB(107,221,211))
                wing.Orientation = Vector3.new(0,0,x*15)
            end
        end
        piece(m,"Tail",Vector3.new(.65,.65,1.5),Vector3.new(0,.1,1.1),color,Enum.PartType.Ball)
    end
    return m
end
return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Strings</string>
          <string name="Source"><![CDATA[-- All interface copy lives here. Add a locale table without rewriting UI logic.
local ko = {
    title="FILAMENT · FISHING", coins="코인", inventory="가방", fish="물고기", eggs="알", pets="펫", tank="수족관", help="도움말",
    silver="은빛 피라미",sunny="햇살 농어",azure="푸른 잉어",tideEgg="물결 알",otter="아기 수달",fox="구름 여우",dragon="별빛 드래곤",
    common="일반",uncommon="고급",rare="희귀",legendary="전설",basic="기본 사료",premium="고급 사료",none="사료 없음",
    dock="낚시터",aquarium="내 수족관",shop="판매 상점",craft="사료 공방",close="닫기",language="EN",rod="낚싯대 장착",
    idle="부두에서 낚시를 시작하세요",charge="놓으면 캐스팅!",flight="찌가 날아갑니다",waiting="입질을 기다리는 중…",reel="누르고 유지해서 끌어올리세요",resist="저항! 빠르게 여러 번 누르세요",success="포획 성공!",failed="물고기가 도망갔습니다",savingCatch="획득 정보를 저장하는 중…",
    castButton="길게 누르기 · 캐스팅",reelButton="길게 누르기 · 끌어올리기",tapButton="연타!",waitingButton="기다려 주세요",cancel="취소",power="캐스팅 파워",progress="포획 진행",resistance="저항 제거",keyHint="PC: F 또는 화면 버튼 / 모바일: 화면 버튼",
    place="수조 배치",retrieve="회수",sell="판매",craftBasic="기본 사료 제작",craftPremium="고급 사료 제작",equip="장착",unequip="해제",equippedLabel="장착 중",bag="가방",inTank="수조 안",incubating="부화 중",ready="부화 처리 중",empty="아직 개체가 없습니다. 낚시로 수집해 보세요.",
    upgrade="수족관 업그레이드",level="레벨",capacity="배치",maxLevel="최대 레벨입니다",feedChoice="알 배치 시 사용할 사료",lockedEgg="부화가 시작된 알은 회수할 수 없습니다",probabilities="부화 예상 확률",snapshotted="배치 시 사료·수조 레벨이 확정됩니다",buff="장착 버프",noPet="장착한 펫 없음",bite="입질 대기",efficiency="포획 효율",seconds="초",price="판매가",
    memory="임시 저장 · Stop 시 초기화",saved="클라우드 저장 완료",saving="저장 중…",error="저장 실패 · 세션 중지",loading="데이터 불러오는 중…",
    granted="아이템을 획득했습니다",placed="수족관에 배치했습니다",retrieved="가방으로 회수했습니다",sold="판매했습니다",crafted="사료를 만들었습니다",upgraded="수족관 레벨이 올랐습니다",equipped="펫을 장착했습니다",unequipped="펫을 해제했습니다",hatched="알이 부화했습니다! 펫 탭을 확인하세요",debugDone="Studio 테스트 데이터를 적용했습니다",
    full="가방이 가득 찼습니다 (최대 200개)",invalid="올바르지 않은 요청입니다",noCoins="코인이 부족합니다",notOwned="본인이 소유한 개체가 아닙니다",stateError="이 상태에서는 사용할 수 없습니다",tankFull="수족관이 가득 찼습니다. 회수하거나 업그레이드하세요",noFeed="선택한 사료가 부족합니다",eggLocked="부화 중인 알은 회수할 수 없습니다",retrieveFirst="수조의 물고기는 먼저 회수하세요",needBetterFish="이 물고기는 고급 사료로 만들 수 없습니다",notReady="아직 준비되지 않았습니다",busy="저장 작업 중입니다. 잠시 뒤 다시 눌러 주세요",serverError="처리 중 오류가 발생했습니다. Output을 확인해 주세요",saveError="저장에 실패했습니다",finishFishing="낚시를 마치거나 취소해 주세요",
    goDock="낚싯대를 장착하고 부두 위로 이동해 주세요",goAquarium="내 수족관으로 이동해 주세요",goShop="판매 상점으로 이동해 주세요",goCraft="사료 공방으로 이동해 주세요",
    helpBody="1. [낚시터]를 누르면 부두로 이동합니다.\n2. F키 또는 캐스팅 버튼을 누르다가 놓으세요.\n3. 입질 후 버튼을 유지해 게이지를 채우세요.\n4. 저항 구간에서는 버튼을 놓고 4초 안에 9번 연타하세요.\n5. 다시 유지하면 물고기나 희귀 알을 획득합니다.\n6. 가방을 열고 내 수족관·상점·공방으로 이동해 활용하세요.\n7. 알은 사료를 선택하고 수조에 배치하면 40~60초 뒤 부화합니다.\n8. 펫 탭에서 장착하면 대기시간과 포획 속도가 실제로 바뀝니다.\n\n물고기와 알에서 부화하는 동물 펫은 별개입니다.\nStudio 임시 모드에서는 Stop 시 모든 데이터가 초기화됩니다.\n클라우드 저장은 README의 비공개 저장 테스트 절차를 따라 주세요.",
    debugTitle="Studio 전용 테스트",debugPack="물고기 3종 + 알 + 재료 지급",debugHatch="배치된 알 즉시 부화",testNotice="라이브 서버에서는 이 기능이 서버에서 차단됩니다",emptyTank="배치한 물고기와 알이 여기에 표시됩니다",
}
local en = {
    title="FILAMENT · FISHING",coins="Coins",inventory="Bag",fish="Fish",eggs="Eggs",pets="Pets",tank="Aquarium",help="Help",
    silver="Silver Minnow",sunny="Sun Perch",azure="Azure Carp",tideEgg="Tide Egg",otter="Baby Otter",fox="Cloud Fox",dragon="Starlight Dragon",
    common="Common",uncommon="Uncommon",rare="Rare",legendary="Legendary",basic="Basic feed",premium="Premium feed",none="No feed",dock="Fishing pier",aquarium="My aquarium",shop="Fish market",craft="Feed workshop",close="Close",language="한국어",rod="Equip rod",
    idle="Start fishing on the pier",charge="Release to cast!",flight="Casting…",waiting="Waiting for a bite…",reel="Hold to reel in",resist="Resistance! Tap rapidly!",success="Caught!",failed="The fish escaped",savingCatch="Saving your catch…",castButton="HOLD · CAST",reelButton="HOLD · REEL",tapButton="TAP!",waitingButton="Please wait",cancel="Cancel",power="Casting power",progress="Catch progress",resistance="Clear resistance",keyHint="PC: F or button / Mobile: touch button",
    place="Place",retrieve="Retrieve",sell="Sell",craftBasic="Basic feed",craftPremium="Premium feed",equip="Equip",unequip="Unequip",equippedLabel="Equipped",bag="Bag",inTank="In tank",incubating="Hatching",ready="Finishing hatch",empty="No items yet. Go fishing!",upgrade="Upgrade aquarium",level="Level",capacity="Capacity",maxLevel="Maximum level",feedChoice="Feed used when placing an egg",lockedEgg="Incubating eggs cannot be retrieved",probabilities="Hatch odds",snapshotted="Feed and tank level are locked when placed",buff="Equipped bonus",noPet="No pet equipped",bite="Bite wait",efficiency="Reel speed",seconds="s",price="Price",
    memory="Temporary · resets on Stop",saved="Cloud saved",saving="Saving…",error="Save failed · session stopped",loading="Loading profile…",granted="Item acquired",placed="Placed in aquarium",retrieved="Returned to bag",sold="Fish sold",crafted="Feed crafted",upgraded="Aquarium upgraded",equipped="Pet equipped",unequipped="Pet unequipped",hatched="Egg hatched! Check the Pets tab",debugDone="Studio test data applied",
    full="Inventory full (200 max)",invalid="Invalid request",noCoins="Not enough coins",notOwned="You do not own this item",stateError="Invalid item state",tankFull="Tank full: retrieve items or upgrade",noFeed="Not enough feed",eggLocked="Incubating eggs are locked",retrieveFirst="Retrieve this fish first",needBetterFish="This fish cannot make premium feed",notReady="Not ready yet",busy="Save in progress. Please try again shortly",serverError="Server error. Check Output",saveError="Save failed",finishFishing="Finish or cancel fishing first",goDock="Equip your rod and stand on the pier",goAquarium="Go to your aquarium",goShop="Go to the fish market",goCraft="Go to the feed workshop",
    helpBody="1. Tap Fishing pier to travel there.\n2. Hold F or the cast button, then release.\n3. After a bite, hold to fill the catch meter.\n4. At resistance, release and tap 9 times in 4 seconds.\n5. Hold again to catch a fish or a rare egg.\n6. Open Bag, then travel to your tank, market or workshop.\n7. Select feed and place an egg; it hatches in 40–60 seconds.\n8. Equip a pet for real bite-time and reel-speed bonuses.\n\nPets are separate animals born from eggs, not evolved fish.\nStudio temporary mode resets all data on Stop.\nFor private cloud-save testing, follow README.",debugTitle="Studio test tools",debugPack="Grant 3 fish + egg + materials",debugHatch="Hatch placed eggs now",testNotice="Server rejects debug tools outside Studio",emptyTank="Placed fish and eggs appear here",
}
return {ko=ko,en=en}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
local Util = {}
function Util.clone(value: any): any
    if type(value) ~= "table" then return value end
    local result = {}
    for k, v in pairs(value) do result[k] = Util.clone(v) end
    return result
end
function Util.count(map: any): number
    local n = 0
    for _ in pairs(map) do n += 1 end
    return n
end
function Util.roll(entries: any, unit: number): string
    local total = 0
    for _, entry in ipairs(entries) do total += entry.weight end
    local target = math.clamp(unit, 0, 0.999999999) * total
    for _, entry in ipairs(entries) do
        target -= entry.weight
        if target < 0 then return entry.id end
    end
    return entries[#entries].id
end
-- A persisted seed produces the same roll after retries or reconnects.
function Util.seedUnit(seed: number): number
    return ((seed * 48271) % 2147483647) / 2147483647
end
return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">FishingService</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Machine = require(Shared.FishingMachine).new(Config.Fishing)
local Service = {}
Service.__index = Service
function Service.new(store, domain, remote, onReward, notify)
    local self = setmetatable({sessions = {}, cooldowns = {}, store = store, domain = domain, remote = remote, onReward = onReward, notify = notify, random = Random.new()},Service)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < .08 then return end
        local step = elapsed
        elapsed = 0
        self:tick(step)
    end)
    return self
end
function Service:valid(player)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local human = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not human or human.Health <= 0 or not char:FindFirstChild("FilamentRod") then return false end
    local f = Config.Fishing
    return math.abs(root.Position.X-f.DockX) <= f.DockHalfX and math.abs(root.Position.Z-f.DockZ) <= f.DockHalfZ and root.Position.Y > 1 and root.Position.Y < 12
end
function Service:cancel(player, quiet)
    local s = self.sessions[player]
    if not s then return end
    self.sessions[player] = nil
    if s.bobber then s.bobber:Destroy() end
    if s.beam then s.beam:Destroy() end
    self.cooldowns[player] = os.clock()+Config.Fishing.Cooldown
    if not quiet and player.Parent then self.remote:FireClient(player,{phase="Failed"}) end
end
function Service:input(player,action)
    local now = os.clock()
    if action == "cancel" then self:cancel(player,false);return end
    local profile = self.store.profiles[player]
    if not profile or profile.closed then return end
    local s = self.sessions[player]
    if action == "start" then
        if s or profile.busy or now < (self.cooldowns[player] or 0) then return end
        if not self:valid(player) then self.notify(player,"goDock");return end
        if Util.count(profile.data.items) >= Config.InventoryLimit then self.notify(player,"full");return end
        local bite,reel = self.domain.buffs(profile.data)
        s = Machine.begin(now,self.random:NextNumber(Config.Fishing.BiteMin,Config.Fishing.BiteMax)*bite,reel)
        self.sessions[player] = s
        self.remote:FireClient(player,{phase="Charge",progress=0,power=0})
    elseif s and self:valid(player) then
        if Machine.input(s,action,now) then self:cast(player,s) end
    end
end
function Service:cast(player,s)
    local root = player.Character.HumanoidRootPart
    local distance = Config.Fishing.MinDistance + (Config.Fishing.MaxDistance-Config.Fishing.MinDistance)*s.power
    local target = Vector3.new(10,Config.Fishing.WaterY,math.clamp(root.Position.Z-distance,-35,30))
    local bobber = Instance.new("Part")
    bobber.Name = "Bobber_"..player.UserId
    bobber.Shape = Enum.PartType.Ball
    bobber.Size = Vector3.new(.65,.65,.65)
    bobber.Anchored = true
    bobber.CanCollide = false
    bobber.Color = Color3.fromRGB(255,140,74)
    bobber.Position = root.Position+Vector3.new(0,3,0)
    local attach = Instance.new("Attachment")
    attach.Parent = bobber
    bobber.Parent = workspace
    local tip = player.Character.FilamentRod.Handle.Tip
    local beam = Instance.new("Beam")
    beam.Attachment0 = tip
    beam.Attachment1 = attach
    beam.Width0 = .035
    beam.Width1 = .025
    beam.FaceCamera = true
    beam.Color = ColorSequence.new(Color3.fromRGB(235,238,222))
    beam.Parent = bobber
    s.bobber = bobber
    s.beam = beam
    TweenService:Create(bobber,TweenInfo.new(Config.Fishing.FlightSeconds,Enum.EasingStyle.Quad),{Position=target}):Play()
end
function Service:tick(dt)
    local now = os.clock()
    for player,s in pairs(self.sessions) do
        if not self:valid(player) then self:cancel(player,false)
        else
            Machine.step(s,now,dt)
            if s.phase == "Success" then
                self:cancel(player,true) -- Consume session before yielding to a save.
                self.remote:FireClient(player,{phase="Saving"})
                local species = Util.roll(Config.CatchTable,self.random:NextNumber())
                local id = HttpService:GenerateGUID(false)
                local seed = self.random:NextInteger(1,2147483646)
                task.spawn(function()
                    -- Lease renewal may be in flight. Wait briefly without rerolling/regranting.
                    local p = self.store.profiles[player]
                    local deadline = os.clock()+12
                    while p and p.busy and os.clock()<deadline do task.wait(.1) end
                    local ok,reason = self.store:transaction(player,function(data)
                        return self.domain.grant(data,species,id,seed,os.time())
                    end)
                    if ok then self.onReward(player); self.remote:FireClient(player,{phase="Success",species=species})
                    elseif player.Parent then self.notify(player,reason);self.remote:FireClient(player,{phase="Failed"}) end
                end)
            elseif s.phase == "Failed" then self:cancel(player,false)
            else
                self.remote:FireClient(player,{phase=s.phase,progress=s.progress,taps=s.taps,
                    remaining=s.deadline and math.max(0,s.deadline-now) or 0,
                    power=s.power or math.clamp((now-s.started)/Config.Fishing.ChargeSeconds,0,1)})
            end
        end
    end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Lease</string>
          <string name="Source"><![CDATA[-- Pure UpdateAsync transformations; nil means refuse, never overwrite another session.
local Lease = {}
function Lease.acquire(old, token, now, ttl, defaultData)
    if old and old.lock and old.lock.token ~= token and old.lock.expires > now then return nil end
    return {data = old and old.data or defaultData, lock = {token = token, expires = now+ttl}}
end
function Lease.write(old, token, now, ttl, data, release)
    if not old or not old.lock or old.lock.token ~= token or old.lock.expires <= now then return nil end
    -- Idempotent retry of the exact same revision is allowed.
    if old.data.revision > data.revision then return nil end
    return {data = data, lock = not release and {token = token, expires = now+ttl} or nil}
end
return Lease
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Util = require(Shared.Util)
local Domain = require(Shared.Domain).new(Config,Catalog,Util)
local World = require(script.Parent.WorldService).new()

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(name)
    local r = Instance.new("RemoteEvent");r.Name = name;r.Parent = remotes;return r
end
local Action = remote("Action")
local Input = remote("FishingInput")
local FishingState = remote("FishingState")
local Snapshot = remote("Snapshot")
local Notice = remote("Notice")
local SaveStatus = remote("SaveStatus")
local OpenPanel = remote("OpenPanel")
remotes.Parent = ReplicatedStorage

local function tell(player,key) if player.Parent then Notice:FireClient(player,key) end end
local Store = require(script.Parent.ProfileStore).new(Domain,function(player,status)
    if player.Parent then SaveStatus:FireClient(player,status) end
end)
local function sync(player)
    local profile = Store.profiles[player]
    if not profile or not player.Parent then return end
    local data = Util.clone(profile.data)
    for _,item in pairs(data.items) do item.seed = nil end -- persisted server-only roll
    data.saveStatus = profile.status
    data.debugEnabled = RunService:IsStudio() and Config.StudioDebug
    data.serverTime = os.time()
    data.plotName = World.plots[player] and World.plots[player].Name
    Snapshot:FireClient(player,data)
    World:sync(player,profile.data)
end
local Fishing = require(script.Parent.FishingService).new(Store,Domain,FishingState,sync,tell)

local buckets = {}
local function allow(player,lane,rate,capacity)
    buckets[player] = buckets[player] or {}
    local now = os.clock()
    local b = buckets[player][lane] or {tokens=capacity,at=now}
    b.tokens = math.min(capacity,b.tokens+(now-b.at)*rate);b.at = now
    buckets[player][lane] = b
    if b.tokens < 1 then return false end
    b.tokens -= 1;return true
end
local function root(player)
    local character = player.Character
    local human = character and character:FindFirstChildOfClass("Humanoid")
    return human and human.Health>0 and character:FindFirstChild("HumanoidRootPart") or nil
end
local function near(player,position)
    local r = root(player)
    return r and (r.Position-position).Magnitude <= Config.StationRadius
end
local aquariumActions = {place=true,retrieve=true,upgrade=true}
local allowedActions = {place=true,retrieve=true,upgrade=true,sell=true,craft=true,equip=true,unequip=true}
local function hatch(player)
    local p = Store.profiles[player]
    if not p or p.closed or p.busy then return end
    local ready = false
    for _,item in pairs(p.data.items) do
        if item.kind=="egg" and item.location=="aquarium" and item.readyAt <= os.time() then ready=true;break end
    end
    if not ready then return end
    local ok = Store:transaction(player,function(data)
        local results = Domain.hatch(data,os.time())
        return #results>0,results
    end)
    if ok then sync(player);tell(player,"hatched") end
end

Input.OnServerEvent:Connect(function(player,action)
    if type(action) ~= "string" or #action > 20 or not allow(player,"input",22,30) then return end
    if action=="start" or action=="release" or action=="hold" or action=="stopHold" or action=="tap" or action=="cancel" then
        Fishing:input(player,action)
    end
end)
Action.OnServerEvent:Connect(function(player,action,id,option)
    if type(action)~="string" or #action>24 then return end
    if id~=nil and (type(id)~="string" or #id>64) then return end
    if option~=nil and (type(option)~="string" or #option>20) then return end
    if not allow(player,"action",2,5) then return end
    local p = Store.profiles[player]
    if not p or p.closed then tell(player,"notReady");return end
    if action=="sync" then sync(player);return end
    if action=="rod" then
        local r = root(player)
        if r then
            local t = player.Backpack:FindFirstChild("FilamentRod")
            if t then player.Character:FindFirstChildOfClass("Humanoid"):EquipTool(t) end
        end
        return
    end
    if action=="travel" then
        if not allow(player,"travel",.5,1) then return end
        local r = root(player)
        local plot = World.plots[player]
        if not r or not plot then return end
        local destinations = {dock=Vector3.new(0,5,23),aquarium=plot.Arrival.Position+Vector3.new(0,2,0),shop=Vector3.new(-28,5,52),craft=Vector3.new(28,5,52)}
        local destination = destinations[id]
        if destination then
            Fishing:cancel(player,true)
            FishingState:FireClient(player,{phase="Idle"})
            player.Character:PivotTo(CFrame.lookAt(destination,destination+Vector3.new(0,0,-1)))
        end
        return
    end
    if action=="debugPack" or action=="debugHatch" then
        if not RunService:IsStudio() or not Config.StudioDebug then return end
        local ok,reason = Store:transaction(player,function(data)
            if action=="debugPack" then
                if Util.count(data.items)+4>Config.InventoryLimit then return false,"full" end
                for _,species in ipairs({"silver","sunny","azure","tideEgg"}) do
                    Domain.grant(data,species,HttpService:GenerateGUID(false),Random.new():NextInteger(1,2147483646),os.time())
                end
                data.coins += 500
                data.feed.basic += 3;data.feed.premium += 3
            else
                for _,item in pairs(data.items) do
                    if item.kind=="egg" and item.location=="aquarium" then
                        local duration=item.readyAt-item.startedAt
                        item.readyAt=os.time();item.startedAt=item.readyAt-duration
                    end
                end
            end
            return true,"debugDone"
        end)
        if ok then sync(player) end;tell(player,reason);return
    end
    if not allowedActions[action] then return end
    if Fishing.sessions[player] then tell(player,"finishFishing");return end
    if not root(player) then tell(player,"notReady");return end
    if aquariumActions[action] then
        local plot = World.plots[player]
        if not plot or not near(player,plot.Anchor.Position) then tell(player,"goAquarium");return end
    elseif action=="sell" and not near(player,World.world.Shop.Position) then tell(player,"goShop");return
    elseif action=="craft" and not near(player,World.world.Craft.Position) then tell(player,"goCraft");return end
    local ok,reason = Store:transaction(player,function(data) return Domain.apply(data,action,id,option,os.time()) end)
    if ok then sync(player) end
    tell(player,reason)
end)

for _,pair in ipairs({{World.world.Shop,"fish"},{World.world.Craft,"fish"}}) do
    pair[1].Prompt.Triggered:Connect(function(player)
        if near(player,pair[1].Position) then OpenPanel:FireClient(player,pair[2]) end
    end)
end
for _,plot in ipairs(World.world.Aquariums:GetChildren()) do
    local prompt=Instance.new("ProximityPrompt")
    prompt.ActionText="수족관 / Aquarium";prompt.ObjectText="FILAMENT";prompt.RequiresLineOfSight=false;prompt.MaxActivationDistance=14
    prompt.Parent=plot.UpgradeConsole
    prompt.Triggered:Connect(function(player)
        if World.plots[player]==plot and near(player,plot.Anchor.Position) then OpenPanel:FireClient(player,"tank") end
    end)
end
local function joined(player)
    if not World:assign(player) then player:Kick("FILAMENT PoC: 수족관 16개가 모두 사용 중입니다. / Server full.");return end
    local function characterAdded()
        Fishing:cancel(player,true)
        task.wait(.4)
        World:rod(player)
        local p=Store.profiles[player]
        if p then sync(player) end
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character then task.spawn(characterAdded) end
    local p = Store:load(player)
    if p then
        if not player.Parent then Store:release(player);World:release(player);return end
        hatch(player)
        sync(player)
    end
end
Players.PlayerAdded:Connect(joined)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(joined,player) end
Players.PlayerRemoving:Connect(function(player)
    Fishing:cancel(player,true)
    Fishing.cooldowns[player]=nil
    buckets[player]=nil
    World:release(player)
    Store:release(player)
end)
task.spawn(function()
    while not Store.closing do
        task.wait(1)
        for player in pairs(Store.profiles) do
            task.spawn(function() hatch(player);Store:renew(player) end)
        end
    end
end)
game:BindToClose(function()
    Store.closing=true
    local count=0
    for player in pairs(Store.profiles) do
        count+=1
        task.spawn(function() Store:release(player);count-=1 end)
    end
    local deadline=os.clock()+25
    while count>0 and os.clock()<deadline do task.wait(.1) end
end)
print("[FILAMENT] Fishing PoC "..Config.Version.." ready. Mode: "..(Store.memory and "STUDIO MEMORY" or "DATASTORE"))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Lease = require(script.Parent.Lease)
local Store = {}
Store.__index = Store

function Store.new(domain, notify)
    local memory = RunService:IsStudio() and not Config.StudioPersistence
    local self = setmetatable({profiles = {}, domain = domain, notify = notify, memory = memory, closing = false}, Store)
    if not memory then
        self.backend = DataStoreService:GetDataStore(Config.DataStoreName .. (RunService:IsStudio() and "_Studio" or "_Live"))
    else
        warn("[FILAMENT] STUDIO MEMORY MODE: data will reset when Stop is pressed. No cloud save is attempted.")
    end
    return self
end
function Store:attempt(callback)
    local lastError
    for attempt = 1, Config.SaveAttempts do
        local ok, result = pcall(callback)
        if ok then return true, result end
        lastError = result
        warn(string.format("[FILAMENT] DataStore attempt %d failed: %s", attempt, tostring(result)))
        if attempt < Config.SaveAttempts then task.wait(2^(attempt-1)) end
    end
    return false, lastError
end
function Store:load(player)
    local token = HttpService:GenerateGUID(false)
    local data = self.domain.default()
    if not self.memory then
        local ok, record = self:attempt(function()
            return self.backend:UpdateAsync("player_"..player.UserId, function(old)
                return Lease.acquire(old, token, os.time(), Config.LeaseSeconds, data)
            end)
        end)
        if not ok or not record or not record.lock or record.lock.token ~= token then
            player:Kick("FILAMENT: 저장 데이터를 불러오지 못했습니다. 다른 세션이 종료된 후 잠시 뒤 다시 접속해 주세요. / Data unavailable or session locked.")
            return nil
        end
        data = record.data
    end
    if not self.domain.valid(data) then
        warn("[FILAMENT] Refusing unsupported/corrupt profile", player.UserId)
        player:Kick("FILAMENT: 저장 데이터 검증 실패. 덮어쓰지 않았습니다. / Invalid save; not overwritten.")
        return nil
    end
    local profile = {data = data, token = token, busy = false, closed = false, lastSave = os.time(), status = self.memory and "memory" or "saved"}
    self.profiles[player] = profile
    return profile
end
function Store:write(player, profile, candidate, release)
    if self.memory then return true end
    self.notify(player, "saving")
    local ok, record = self:attempt(function()
        return self.backend:UpdateAsync("player_"..player.UserId, function(old)
            return Lease.write(old, profile.token, os.time(), Config.LeaseSeconds, candidate, release)
        end)
    end)
    if not ok or not record or record.data.revision ~= candidate.revision or (not release and (not record.lock or record.lock.token ~= profile.token)) then
        profile.status = "error"
        profile.closed = true
        self.notify(player, "error")
        warn("[FILAMENT] Save failed/lock lost; session frozen to prevent divergent writes", player.UserId)
        task.delay(2, function()
            if player.Parent then player:Kick("FILAMENT: 저장 오류로 세션을 중지했습니다. 잠시 후 재접속해 주세요. / Save failed; reconnect shortly.") end
        end)
        return false
    end
    profile.lastSave = os.time()
    return true
end
function Store:transaction(player, mutate)
    local p = self.profiles[player]
    if not p or p.closed or self.closing then return false, "notReady" end
    if p.busy then return false, "busy" end
    p.busy = true
    local candidate = Util.clone(p.data)
    local ran, changed, result = pcall(mutate, candidate)
    if not ran then
        warn("[FILAMENT] Transaction exception", changed)
        p.busy = false
        return false, "serverError"
    end
    if not changed then p.busy = false; return false, result end
    candidate.revision += 1
    if not self.domain.valid(candidate) then
        p.busy = false
        warn("[FILAMENT] Rejected invalid transaction")
        return false, "serverError"
    end
    if not self:write(player, p, candidate, false) then p.busy = false; return false, "saveError" end
    p.data = candidate -- publish only after a durable commit (or explicit Studio memory mode).
    p.status = self.memory and "memory" or "saved"
    p.busy = false
    self.notify(player, p.status)
    return true, result
end
function Store:renew(player)
    local p = self.profiles[player]
    if not p or p.closed or p.busy or self.memory or os.time()-p.lastSave < Config.RenewSeconds then return end
    p.busy = true
    if self:write(player, p, p.data, false) then p.status = "saved"; self.notify(player, "saved") end
    p.busy = false
end
function Store:release(player)
    local p = self.profiles[player]
    if not p then return end
    local deadline = os.clock()+20
    while p.busy and os.clock() < deadline do task.wait(0.1) end
    if not p.busy and not p.closed then
        p.busy = true
        self:write(player, p, p.data, true)
        p.closed = true
    end
    self.profiles[player] = nil
end
return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage").Shared
local Catalog = require(Shared.Catalog)
local Models = require(Shared.Models)
local WorldService = {}
WorldService.__index = WorldService
function WorldService.new()
    local self = setmetatable({plots = {}, world = workspace:WaitForChild("World")},WorldService)
    self.visuals = Instance.new("Folder")
    self.visuals.Name = "Visuals"
    self.visuals.Parent = workspace
    workspace.Terrain.WaterColor = Color3.fromRGB(49,148,171)
    workspace.Terrain.WaterTransparency = .45
    workspace.Terrain.WaterWaveSize = .12
    workspace.Terrain.WaterWaveSpeed = 8
    workspace.Terrain:FillBlock(CFrame.new(0,-2,0),Vector3.new(104,4,80),Enum.Material.Water)
    self.world.WaterPreview:Destroy()
    return self
end
function WorldService:assign(player)
    local plots = self.world.Aquariums:GetChildren()
    table.sort(plots,function(a,b) return a.Name < b.Name end)
    for _,plot in ipairs(plots) do
        if not plot:GetAttribute("OwnerUserId") then
            plot:SetAttribute("OwnerUserId",player.UserId)
            self.plots[player] = plot
            local group = Instance.new("Folder")
            group.Name = tostring(player.UserId)
            group.Parent = self.visuals
            return plot
        end
    end
    return nil
end
function WorldService:sync(player,data)
    local plot = self.plots[player]
    if not plot then return end
    plot.OwnerSign.Label.Text.Text = player.DisplayName .. "\nLv."..data.aquariumLevel.." AQUARIUM"
    local group = self.visuals:FindFirstChild(tostring(player.UserId))
    group:ClearAllChildren()
    local ids = {}
    for id,item in pairs(data.items) do if item.location == "aquarium" then table.insert(ids,id) end end
    table.sort(ids)
    for index,id in ipairs(ids) do
        local item = data.items[id]
        local m = Models.make(item.kind,item.species,Catalog[item.species].color)
        m.Name = id
        m:SetAttribute("VisualKind",item.kind)
        m:SetAttribute("OwnerUserId",player.UserId)
        m:SetAttribute("SwimIndex",index)
        m:SetAttribute("TankCenter",plot.Anchor.Position)
        m:PivotTo(CFrame.new(plot.Anchor.Position+Vector3.new((index%5-2)*3,-1,0)))
        m.Parent = group
    end
    local pet = data.items[data.equippedPet]
    if pet then
        local m = Models.make("pet",pet.species,Catalog[pet.species].color)
        m.Name = "EquippedPet"
        m:SetAttribute("VisualKind","follower")
        m:SetAttribute("OwnerUserId",player.UserId)
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        m:PivotTo(root and root.CFrame or CFrame.new(plot.Arrival.Position))
        m.Parent = group
    end
end
function WorldService:release(player)
    local plot = self.plots[player]
    if plot then plot:SetAttribute("OwnerUserId",nil); plot.OwnerSign.Label.Text.Text = "VACANT" end
    self.plots[player] = nil
    local group = self.visuals:FindFirstChild(tostring(player.UserId))
    if group then group:Destroy() end
end
function WorldService:rod(player)
    if not player.Character then return end
    local backpack = player:WaitForChild("Backpack",10)
    if not backpack then return end
    local previous = backpack:FindFirstChild("FilamentRod")
    if previous then previous:Destroy() end
    previous = player.Character:FindFirstChild("FilamentRod")
    if previous then previous:Destroy() end
    local tool = Instance.new("Tool")
    tool.Name = "FilamentRod"
    tool.ToolTip = "FILAMENT · 낚싯대 / Fishing Rod"
    tool.CanBeDropped = false
    tool.Grip = CFrame.new(0,-1,0)*CFrame.Angles(math.rad(-25),0,0)
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(.18,5,.18)
    handle.Color = Color3.fromRGB(104,72,49)
    handle.Material = Enum.Material.Wood
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool
    local tip = Instance.new("Attachment")
    tip.Name = "Tip"
    tip.Position = Vector3.new(0,2.5,0)
    tip.Parent = handle
    tool.Parent = backpack
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid:EquipTool(tool) end
end
return WorldService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="18">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="19">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="20">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="22">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local visuals=workspace:WaitForChild("Visuals")
local tracked={}
local function add(model)
    if model:IsA("Model") and model:GetAttribute("VisualKind") then tracked[model]=true end
end
for _,v in ipairs(visuals:GetDescendants()) do add(v) end
visuals.DescendantAdded:Connect(add)
visuals.DescendantRemoving:Connect(function(v) tracked[v]=nil end)
local elapsed=0
RunService.RenderStepped:Connect(function(dt)
    elapsed+=dt
    if elapsed<1/30 then return end
    elapsed=0
    local now=workspace:GetServerTimeNow()
    for model in pairs(tracked) do
        if not model.Parent then tracked[model]=nil;continue end
        local kind=model:GetAttribute("VisualKind")
        if kind=="follower" then
            local owner=Players:GetPlayerByUserId(model:GetAttribute("OwnerUserId"))
            local root=owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local target=root.CFrame*CFrame.new(3,1+math.sin(now*2)*.35,3)
                model:PivotTo(model:GetPivot():Lerp(target,.18))
            end
        else
            local center=model:GetAttribute("TankCenter")
            local i=model:GetAttribute("SwimIndex") or 1
            if center then
                if kind=="fish" then
                    local t=now*.45+i*1.7
                    local pos=center+Vector3.new(math.cos(t)*7,math.sin(t*.7+i)*1.2,math.sin(t)*3.2)
                    local nextPos=center+Vector3.new(math.cos(t+.08)*7,math.sin((t+.08)*.7+i)*1.2,math.sin(t+.08)*3.2)
                    model:PivotTo(CFrame.lookAt(pos,nextPos))
                else
                    model:PivotTo(CFrame.new(center+Vector3.new(((i-1)%5-2)*3.4,-1+math.sin(now+i)*.15,2))*CFrame.Angles(0,now*.35,0))
                end
            end
        end
    end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="23">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local UserInputService=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local Shared=ReplicatedStorage:WaitForChild("Shared")
local Config=require(Shared.Config)
local Catalog=require(Shared.Catalog)
local Strings=require(Shared.Strings)
local Layout=require(Shared.Layout)
local Domain=require(Shared.Domain).new(Config,Catalog,require(Shared.Util))
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local Action=remotes:WaitForChild("Action")
local FishingInput=remotes:WaitForChild("FishingInput")
local palette={bg=Color3.fromRGB(17,39,48),card=Color3.fromRGB(29,58,67),line=Color3.fromRGB(65,104,111),text=Color3.fromRGB(244,239,219),muted=Color3.fromRGB(170,199,199),accent=Color3.fromRGB(255,174,89),mint=Color3.fromRGB(111,218,191),red=Color3.fromRGB(255,126,116)}
local locale=string.sub(player.LocaleId,1,2)=="ko" and "ko" or "en"
local data=nil
local snapshotAt=0
local selectedTab="fish"
local feedQuality="none"
local fishState={phase="Idle",progress=0,power=0,taps=0,remaining=0}
local held=false
local castPressed=false
local pointer=nil
local actionPendingUntil=0
local timers={}
local function t(key) return Strings[locale][key] or Strings.en[key] or tostring(key) end
local function new(class,parent,props)
    local obj=Instance.new(class)
    for k,v in pairs(props or {}) do obj[k]=v end
    obj.Parent=parent
    return obj
end
local function corner(obj,radius) new("UICorner",obj,{CornerRadius=UDim.new(0,radius or 10)}) end
local function label(parent,text,pos,size,textSize,color)
    return new("TextLabel",parent,{Text=text,Position=pos,Size=size,BackgroundTransparency=1,Font=Enum.Font.Gotham,TextSize=textSize or 14,TextColor3=color or palette.text,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true})
end
local function button(parent,text,pos,size,callback,color)
    local b=new("TextButton",parent,{Text=text,Position=pos,Size=size,BackgroundColor3=color or palette.line,TextColor3=palette.text,Font=Enum.Font.GothamBold,TextSize=13,TextWrapped=true,AutoButtonColor=true})
    corner(b,8)
    if callback then b.Activated:Connect(callback) end
    return b
end
local gui=new("ScreenGui",player:WaitForChild("PlayerGui"),{Name="FilamentUI",ResetOnSpawn=false,IgnoreGuiInset=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=10})
local hud=new("Frame",gui,{Position=UDim2.fromOffset(12,6),Size=UDim2.new(1,-24,0,48),BackgroundColor3=palette.bg})
corner(hud)
local title=label(hud,t("title"),UDim2.fromOffset(12,3),UDim2.new(.6,-12,0,21),13)
title.Font=Enum.Font.GothamBold
local money=label(hud,"—",UDim2.new(.6,0,0,3),UDim2.new(.4,-12,0,21),15,palette.accent)
money.TextXAlignment=Enum.TextXAlignment.Right
local saveLabel=label(hud,t("loading"),UDim2.fromOffset(12,26),UDim2.new(1,-24,0,16),11,palette.muted)
local nav=new("ScrollingFrame",gui,{Position=UDim2.fromOffset(12,60),Size=UDim2.new(1,-24,0,36),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=0,ScrollingDirection=Enum.ScrollingDirection.X,AutomaticCanvasSize=Enum.AutomaticSize.X,CanvasSize=UDim2.new()})
new("UIListLayout",nav,{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
local fishing=new("Frame",gui,{AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,108),Size=UDim2.fromOffset(430,194),BackgroundColor3=palette.bg,BackgroundTransparency=.06})
corner(fishing,14)
local fishTitle=label(fishing,t("idle"),UDim2.fromOffset(14,8),UDim2.new(1,-65,0,28),16)
fishTitle.Font=Enum.Font.GothamBold
local cancelButton=button(fishing,"×",UDim2.new(1,-44,0,7),UDim2.fromOffset(32,30),function() FishingInput:FireServer("cancel");held=false;castPressed=false end)
local gaugeText=label(fishing,t("power"),UDim2.fromOffset(14,43),UDim2.new(1,-28,0,20),12,palette.muted)
local track=new("Frame",fishing,{Position=UDim2.fromOffset(14,68),Size=UDim2.new(1,-28,0,14),BackgroundColor3=palette.line,BorderSizePixel=0})
corner(track,7)
local fill=new("Frame",track,{Size=UDim2.fromScale(0,1),BackgroundColor3=palette.mint,BorderSizePixel=0})
corner(fill,7)
local resistanceMark=new("Frame",track,{Position=UDim2.fromScale(Config.Fishing.ResistanceAt,0),Size=UDim2.new(0,3,1,0),BackgroundColor3=palette.accent,BorderSizePixel=0})
local resistanceText=label(fishing,"",UDim2.fromOffset(14,85),UDim2.new(1,-28,0,20),12,palette.accent)
local actionButton=button(fishing,t("castButton"),UDim2.fromOffset(14,112),UDim2.new(1,-28,0,48),nil,palette.accent)
actionButton.TextColor3=palette.bg
local keyHint=label(fishing,t("keyHint"),UDim2.fromOffset(14,166),UDim2.new(1,-28,0,18),11,palette.muted)
keyHint.TextXAlignment=Enum.TextXAlignment.Center
local toast=label(gui,"",UDim2.new(.5,0,0,310),UDim2.new(1,-30,0,44),14,palette.text)
toast.AnchorPoint=Vector2.new(.5,0);toast.BackgroundColor3=palette.bg;toast.BackgroundTransparency=.08;toast.TextXAlignment=Enum.TextXAlignment.Center;toast.Visible=false;toast.ZIndex=30;corner(toast)
local toastSequence=0
local function notify(key)
    toastSequence+=1
    local sequence=toastSequence
    toast.Text=t(key);toast.Visible=true
    task.delay(3.5,function() if toastSequence==sequence then toast.Visible=false end end)
end
local overlay=new("Frame",gui,{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=.35,Visible=false,ZIndex=20,Active=true})
local panel=new("Frame",overlay,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(760,560),BackgroundColor3=palette.bg})
corner(panel,14)
local panelTitle=label(panel,t("inventory"),UDim2.fromOffset(16,8),UDim2.new(1,-130,0,30),21)
panelTitle.Font=Enum.Font.GothamBold
local close=button(panel,t("close"),UDim2.new(1,-90,0,8),UDim2.fromOffset(74,32),function() overlay.Visible=false end)
local tabs=new("ScrollingFrame",panel,{Position=UDim2.fromOffset(12,48),Size=UDim2.new(1,-24,0,38),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=2,ScrollingDirection=Enum.ScrollingDirection.X,AutomaticCanvasSize=Enum.AutomaticSize.X,CanvasSize=UDim2.new()})
new("UIListLayout",tabs,{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
local content=new("ScrollingFrame",panel,{Position=UDim2.fromOffset(12,94),Size=UDim2.new(1,-24,1,-108),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollingDirection=Enum.ScrollingDirection.Y})
local list=new("UIListLayout",content,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder})
local navButtons={}
local tabButtons={}
local render
local function send(action,id,option)
    if os.clock()<actionPendingUntil then return end
    actionPendingUntil=os.clock()+.55
    Action:FireServer(action,id,option)
end
local function release()
    held=false;pointer=nil
    if castPressed then FishingInput:FireServer("release");castPressed=false end
    FishingInput:FireServer("stopHold")
end
local function open(tab)
    release()
    if fishState.phase~="Idle" then FishingInput:FireServer("cancel") end
    selectedTab=tab or selectedTab
    overlay.Visible=true
    render()
end
local function travel(destination)
    release();overlay.Visible=false
    Action:FireServer("travel",destination)
end
local function row(height)
    local f=new("Frame",content,{Size=UDim2.new(1,-6,0,height),BackgroundColor3=palette.card,BorderSizePixel=0})
    corner(f,10);return f
end
local function itemCard(item)
    local def=Catalog[item.species]
    local egg=item.kind=="egg"
    local inTank=item.location=="aquarium"
    local f=row(egg and 142 or (item.kind=="fish" and 148 or 126))
    local dot=new("Frame",f,{Position=UDim2.fromOffset(12,14),Size=UDim2.fromOffset(12,12),BackgroundColor3=Color3.fromRGB(def.color[1],def.color[2],def.color[3]),BorderSizePixel=0})
    corner(dot,6)
    label(f,t(def.nameKey).." · "..t(def.rarity),UDim2.fromOffset(32,7),UDim2.new(1,-42,0,27),15)
    label(f,(inTank and t("inTank") or t("bag")).." · #"..string.sub(item.id,1,7),UDim2.fromOffset(12,36),UDim2.new(1,-24,0,18),11,palette.muted)
    local function action(text,index,count,callback,y)
        return button(f,text,UDim2.new((index-1)/count,8,0,y or 96),UDim2.new(1/count,-16,0,40),callback)
    end
    if item.kind=="fish" then
        label(f,t("price").." "..def.value.." · "..t("basic").." ×"..def.basicYield.." · "..t("premium").." ×"..def.premiumYield,UDim2.fromOffset(12,59),UDim2.new(1,-24,0,28),12)
        if inTank then action(t("retrieve"),1,1,function() send("retrieve",item.id) end)
        else
            action(t("place"),1,4,function() send("place",item.id) end)
            action(t("sell"),2,4,function() send("sell",item.id) end)
            action(t("craftBasic"),3,4,function() send("craft",item.id,"basic") end)
            action(t("craftPremium"),4,4,function() send("craft",item.id,"premium") end)
        end
    elseif egg then
        if inTank then
            local timer=label(f,"",UDim2.fromOffset(12,60),UDim2.new(1,-24,0,24),15,palette.accent)
            table.insert(timers,{label=timer,readyAt=item.readyAt})
            label(f,t(item.feedQuality).." · Lv."..item.incubationLevel.."\n"..t("lockedEgg"),UDim2.fromOffset(12,88),UDim2.new(1,-24,0,44),12,palette.muted)
        else
            label(f,t(feedQuality).." · "..Config.Feed[feedQuality].duration..t("seconds"),UDim2.fromOffset(12,61),UDim2.new(1,-24,0,22),13,palette.accent)
            action(t("place"),1,1,function() send("place",item.id,feedQuality) end,92)
        end
    else
        label(f,t("bite").." -"..math.floor((1-def.biteMultiplier)*100+.5).."%  ·  "..t("efficiency").." +"..math.floor((def.reelMultiplier-1)*100+.5).."%",UDim2.fromOffset(12,58),UDim2.new(1,-24,0,20),12,palette.mint)
        local equipped=data.equippedPet==item.id
        action(equipped and (t("equippedLabel").." · "..t("unequip")) or t("equip"),1,1,function() send(equipped and "unequip" or "equip",item.id) end,82)
    end
end
render=function()
    if not overlay.Visible then return end
    local previousScroll=content.CanvasPosition
    for _,child in ipairs(content:GetChildren()) do if child~=list then child:Destroy() end end
    timers={}
    for key,b in pairs(tabButtons) do b.Text=t(key);b.BackgroundColor3=selectedTab==key and palette.accent or palette.line;b.TextColor3=selectedTab==key and palette.bg or palette.text end
    panelTitle.Text=t(selectedTab);close.Text=t("close")
    if not data then local f=row(60);label(f,t("loading"),UDim2.fromOffset(12,5),UDim2.new(1,-24,1,-10));return end
    if selectedTab=="help" then
        local f=row(0)
        f.AutomaticSize=Enum.AutomaticSize.Y
        new("UIPadding",f,{PaddingTop=UDim.new(0,12),PaddingBottom=UDim.new(0,12),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12)})
        local helpText=label(f,t("helpBody"),UDim2.new(),UDim2.new(1,0,0,0),13)
        helpText.AutomaticSize=Enum.AutomaticSize.Y
        helpText.TextYAlignment=Enum.TextYAlignment.Top
        local languageRow=row(52)
        button(languageRow,t("language"),UDim2.fromOffset(8,6),UDim2.new(1,-16,0,40),function() locale=locale=="ko" and "en" or "ko";render() end)
        if data.debugEnabled then
            local d=row(164)
            label(d,t("debugTitle"),UDim2.fromOffset(12,5),UDim2.new(1,-24,0,26),16,palette.accent)
            button(d,t("debugPack"),UDim2.fromOffset(10,40),UDim2.new(1,-20,0,40),function() send("debugPack") end)
            button(d,t("debugHatch"),UDim2.fromOffset(10,86),UDim2.new(1,-20,0,40),function() send("debugHatch") end)
            label(d,t("testNotice"),UDim2.fromOffset(12,130),UDim2.new(1,-24,0,26),11,palette.muted)
        end
        return
    end
    local shortcuts=row(48)
    for index,key in ipairs({"aquarium","shop","craft"}) do
        button(shortcuts,t(key),UDim2.new((index-1)/3,5,0,5),UDim2.new(1/3,-10,0,38),function() travel(key) end)
    end
    if selectedTab=="tank" then
        local f=row(106)
        local lv=data.aquariumLevel
        label(f,t("level").." "..lv.." · "..t("capacity").." "..Domain.occupied(data).."/"..Config.Aquarium[lv].capacity,UDim2.fromOffset(12,8),UDim2.new(1,-24,0,24),16)
        button(f,lv<3 and (t("upgrade").." · "..Config.Aquarium[lv].nextCost.." "..t("coins")) or t("maxLevel"),UDim2.fromOffset(10,51),UDim2.new(1,-20,0,42),function() send("upgrade") end)
    elseif selectedTab=="eggs" then
        local f=row(180)
        label(f,t("feedChoice"),UDim2.fromOffset(12,4),UDim2.new(1,-24,0,25),14)
        for index,key in ipairs({"none","basic","premium"}) do
            local count=key=="none" and "" or " ×"..data.feed[key]
            button(f,(feedQuality==key and "✓ " or "")..t(key)..count,UDim2.new((index-1)/3,6,0,36),UDim2.new(1/3,-12,0,42),function() feedQuality=key;render() end,feedQuality==key and palette.line or palette.bg)
        end
        local entries=Domain.weights(data.aquariumLevel,feedQuality,Config.Feed[feedQuality].duration)
        local total=0
        for _,entry in ipairs(entries) do total+=entry.weight end
        local parts={}
        for _,entry in ipairs(entries) do table.insert(parts,t(Catalog[entry.id].rarity).." "..string.format("%.2f%%",100*entry.weight/total)) end
        label(f,t("probabilities").."\n"..table.concat(parts," · "),UDim2.fromOffset(12,86),UDim2.new(1,-24,0,48),12,palette.mint)
        label(f,t("snapshotted"),UDim2.fromOffset(12,139),UDim2.new(1,-24,0,32),11,palette.muted)
    elseif selectedTab=="fish" then
        local f=row(50)
        label(f,t("basic").." ×"..data.feed.basic.."  ·  "..t("premium").." ×"..data.feed.premium,UDim2.fromOffset(12,5),UDim2.new(1,-24,1,-10),13,palette.mint)
    elseif selectedTab=="pets" then
        local f=row(60)
        local pet=data.items[data.equippedPet]
        label(f,t("buff")..": "..(pet and t(pet.species) or t("noPet")),UDim2.fromOffset(12,5),UDim2.new(1,-24,1,-10),14,palette.mint)
    end
    local items={}
    for _,item in pairs(data.items) do
        if (selectedTab=="fish" and item.kind=="fish") or (selectedTab=="eggs" and item.kind=="egg") or (selectedTab=="pets" and item.kind=="pet") or (selectedTab=="tank" and item.location=="aquarium") then table.insert(items,item) end
    end
    table.sort(items,function(a,b) if a.obtainedAt==b.obtainedAt then return a.id<b.id end;return a.obtainedAt>b.obtainedAt end)
    for _,item in ipairs(items) do itemCard(item) end
    if #items==0 then local f=row(90);label(f,t(selectedTab=="tank" and "emptyTank" or "empty"),UDim2.fromOffset(12,8),UDim2.new(1,-24,1,-16),14,palette.muted) end
    task.defer(function() content.CanvasPosition=previousScroll end)
end
for index,key in ipairs({"fish","eggs","pets","tank","help"}) do
    local b=button(tabs,t(key),UDim2.new(),UDim2.fromOffset(92,34),function() selectedTab=key;content.CanvasPosition=Vector2.zero;render() end)
    b.LayoutOrder=index;tabButtons[key]=b
end
for index,key in ipairs({"inventory","dock","aquarium","shop","craft","rod","help"}) do
    local b=button(nav,t(key),UDim2.new(),UDim2.fromOffset(key=="inventory" and 78 or 102,36),function()
        if key=="inventory" then open(selectedTab)
        elseif key=="help" then open("help")
        elseif key=="rod" then Action:FireServer("rod")
        else travel(key) end
    end,key=="inventory" and palette.accent or palette.bg)
    if key=="inventory" then b.TextColor3=palette.bg end
    b.LayoutOrder=index;navButtons[key]=b
end
local function resize()
    local size=gui.AbsoluteSize
    local metrics=Layout.metrics(size.X,size.Y)
    panel.Size=UDim2.fromOffset(metrics.panelWidth,metrics.panelHeight)
    fishing.Size=UDim2.fromOffset(metrics.fishWidth,194)
    fishing.Position=UDim2.new(.5,0,0,metrics.fishY)
    toast.Position=UDim2.new(.5,0,0,metrics.fishY+200)
    if size.Y<390 then toast.Position=UDim2.new(.5,0,0,6) end
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
resize()
local function press()
    if overlay.Visible or not data then return end
    if held then return end
    held=true
    local phase=fishState.phase
    if phase=="Idle" or phase=="Success" or phase=="Failed" then
        castPressed=true;FishingInput:FireServer("start")
    elseif phase=="Resist" then FishingInput:FireServer("tap")
    elseif phase=="Reel" then FishingInput:FireServer("hold") end
end
actionButton.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        if not pointer then pointer=input;press() end
    end
end)
UserInputService.InputBegan:Connect(function(input,processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode==Enum.KeyCode.F then press()
    elseif input.KeyCode==Enum.KeyCode.B then if overlay.Visible then overlay.Visible=false else open() end
    elseif input.KeyCode==Enum.KeyCode.R then Action:FireServer("rod") end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode==Enum.KeyCode.F or input==pointer or (input.UserInputType==Enum.UserInputType.MouseButton1 and pointer and pointer.UserInputType==Enum.UserInputType.MouseButton1) then release() end
end)
UserInputService.WindowFocusReleased:Connect(release)
local phaseKeys={Idle="idle",Charge="charge",Flight="flight",Waiting="waiting",Reel="reel",Resist="resist",Success="success",Failed="failed",Saving="savingCatch"}
local function updateFishing()
    local phase=fishState.phase
    fishTitle.Text=t(phaseKeys[phase] or "idle")..(fishState.species and (" · "..t(fishState.species)) or "")
    keyHint.Text=t("keyHint")
    resistanceMark.Visible=phase=="Reel" or phase=="Resist"
    local value=fishState.progress or 0
    gaugeText.Text=t("progress").." · "..math.floor(value*100).."%"
    fill.BackgroundColor3=palette.mint
    resistanceText.Text=""
    if phase=="Idle" or phase=="Charge" then
        value=fishState.power or 0
        gaugeText.Text=t("power").." · "..math.floor(value*100).."%"
        actionButton.Text=t("castButton")
    elseif phase=="Reel" then actionButton.Text=t("reelButton")
    elseif phase=="Resist" then
        value=(fishState.taps or 0)/Config.Fishing.ResistanceTaps
        gaugeText.Text=t("resistance").." · "..(fishState.taps or 0).."/"..Config.Fishing.ResistanceTaps
        fill.BackgroundColor3=palette.accent
        resistanceText.Text=string.format("%.1f",fishState.remaining or 0)..t("seconds")
        actionButton.Text=t("tapButton")
    elseif phase=="Success" or phase=="Failed" then actionButton.Text=t("castButton")
    else actionButton.Text=t("waitingButton") end
    fill.Size=UDim2.fromScale(math.clamp(value,0,1),1)
    cancelButton.Visible=phase~="Idle" and phase~="Success" and phase~="Failed"
end
remotes.FishingState.OnClientEvent:Connect(function(state)
    fishState=state
    if state.phase=="Failed" or state.phase=="Success" or state.phase=="Idle" then held=false;castPressed=false end
    updateFishing()
    if state.phase=="Success" or state.phase=="Failed" then
        local exact=state
        task.delay(2.5,function() if fishState==exact then fishState={phase="Idle"};updateFishing() end end)
    end
end)
remotes.Snapshot.OnClientEvent:Connect(function(snapshot)
    data=snapshot;snapshotAt=os.clock();actionPendingUntil=0
    money.Text=t("coins").." "..data.coins
    saveLabel.Text=t(data.saveStatus)
    saveLabel.TextColor3=data.saveStatus=="memory" and palette.accent or palette.mint
    render()
end)
remotes.SaveStatus.OnClientEvent:Connect(function(status)
    saveLabel.Text=t(status);saveLabel.TextColor3=status=="error" and palette.red or (status=="memory" and palette.accent or palette.mint)
    if data then data.saveStatus=status end
end)
remotes.Notice.OnClientEvent:Connect(function(key) actionPendingUntil=0;notify(key) end)
remotes.OpenPanel.OnClientEvent:Connect(open)
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt
    if elapsed<.15 then return end
    elapsed=0
    if held and fishState.phase=="Reel" and not overlay.Visible then FishingInput:FireServer("hold") end
    if data then
        local now=data.serverTime+os.clock()-snapshotAt
        for _,entry in ipairs(timers) do
            if entry.label.Parent then
                local remaining=math.max(0,math.ceil(entry.readyAt-now))
                entry.label.Text=remaining==0 and t("ready") or (t("incubating").." · "..remaining..t("seconds"))
            end
        end
        money.Text=t("coins").." "..data.coins
        saveLabel.Text=t(data.saveStatus)
    end
    title.Text=t("title")
    for key,b in pairs(navButtons) do b.Text=t(key) end
    updateFishing()
end)
player.CharacterAdded:Connect(function() held=false;castPressed=false;fishState={phase="Idle"};updateFishing() end)
task.spawn(function()
    for _=1,12 do
        Action:FireServer("sync")
        if data then return end
        task.wait(2)
    end
end)
