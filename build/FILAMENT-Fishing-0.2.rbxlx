      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Zones</string>
          <string name="Source"><![CDATA[-- Pure geometry/access rules. Position values are {x,y,z}, shared with CLI tests.
local Zones={}
function Zones.new(config)
    local self={config=config}
    local function finite(v) return type(v)=="number" and v==v and math.abs(v)<1e7 end
    function self.point(p) return type(p)=="table" and finite(p[1]) and finite(p[2]) and finite(p[3]) end
    function self.contains(id,p,inset)
        local z=config.zones[id]
        if not z or not self.point(p) then return false end
        local margin=inset or 0
        return math.abs(p[1]-z.position[1])<=z.size[1]/2-margin and math.abs(p[3]-z.position[3])<=z.size[3]/2-margin
    end
    function self.onFloor(id,p)
        local z=config.zones[id]
        if not z or not self.contains(id,p) then return false end
        local top=z.position[2]+z.size[2]/2
        return p[2]>=top+1 and p[2]<=top+9
    end
    function self.interact(id,p)
        local z=config.zones[id]
        if not z or not z.interactionDistance or not self.onFloor(id,p) then return false end
        local q=z.interaction
        return (p[1]-q[1])^2+(p[2]-q[2])^2+(p[3]-q[3])^2<=z.interactionDistance^2
    end
    function self.isPlot(id) return type(id)=="string" and config.zones[id]~=nil and config.zones[id].type=="plot" end
    function self.context(p,ownPlot)
        if self.isPlot(ownPlot) and self.interact(ownPlot,p) then return "aquarium" end
        if self.interact("FishMarket",p) then return "shop" end
        if self.interact("FeedWorkshop",p) then return "craft" end
        return "bag"
    end
    function self.authorize(action,p,ownPlot)
        if action=="place" or action=="retrieve" or action=="upgrade" then
            if self.isPlot(ownPlot) and self.interact(ownPlot,p) then return true end
            return false,"goAquarium"
        elseif action=="sell" then return self.interact("FishMarket",p),"goShop"
        elseif action=="craft" then return self.interact("FeedWorkshop",p),"goCraft"
        elseif action=="equip" or action=="unequip" then return self.point(p),"notReady" end
        return false,"invalid"
    end
    function self.canFish(p) return self.onFloor("FishingDock",p) end
    function self.waterTarget(p)
        local lake=config.zones.FishingLake
        return self.contains("FishingLake",p,.5) and not self.contains("FishingDock",p,-.4)
            and math.abs(p[2]-(lake.position[2]+lake.size[2]/2+.35))<.05
    end
    function self.castTarget(p,power,fishing)
        if not self.canFish(p) or not finite(power) then return nil end
        local lake,dock=config.zones.FishingLake,config.zones.FishingDock
        local distance=fishing.MinDistance+(fishing.MaxDistance-fishing.MinDistance)*math.clamp(power,0,1)
        local target={dock.position[1]+dock.size[1]/2+3,lake.position[2]+lake.size[2]/2+.35,
            math.clamp(p[3]-distance,lake.position[3]-lake.size[3]/2+2,lake.position[3]+lake.size[3]/2-2)}
        return self.waterTarget(target) and target or nil
    end
    function self.slot(id,index)
        local z=config.zones[id]
        assert(self.isPlot(id) and index>=1 and index<=10)
        return {z.position[1]+((index-1)%5-2)*4,z.position[2]+z.size[2]/2+2,z.position[3]+(index>5 and -3 or 1)}
    end
    return self
end
return Zones
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">FishingService</string>
          <string name="Source"><![CDATA[local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Config=require(Shared.Config)
local Util=require(Shared.Util)
local Machine=require(Shared.FishingMachine).new(Config.Fishing)
local Service={};Service.__index=Service
function Service.new(store,domain,rewards,zones,remote,onReward,notify)
    local self=setmetatable({sessions={},pending={},cooldowns={},store=store,domain=domain,rewards=rewards,zones=zones,
        remote=remote,onReward=onReward,notify=notify,random=Random.new()},Service)
    local elapsed=0
    RunService.Heartbeat:Connect(function(dt)
        elapsed+=dt;if elapsed<.08 then return end
        local step=elapsed;elapsed=0;self:tick(step)
    end)
    return self
end
function Service:busy(player) return self.sessions[player]~=nil or self.pending[player]==true end
function Service:valid(player)
    local p=self.zones:position(player)
    return self.zones.rules.canFish(p) and player.Character:FindFirstChild(self.zones.config.rodName)~=nil
end
function Service:cancel(player,quiet)
    local s=self.sessions[player];if not s then return end
    self.sessions[player]=nil
    if s.bobber then s.bobber:Destroy() end
    self.cooldowns[player]=os.clock()+Config.Fishing.Cooldown
    if not quiet and player.Parent then self.remote:FireClient(player,{phase="Failed"}) end
end
function Service:input(player,action)
    if action=="cancel" then self:cancel(player,false);return end
    local now=os.clock();local p=self.store.profiles[player]
    if not p or p.closed then return end
    local s=self.sessions[player]
    if action=="start" then
        if self:busy(player) or p.busy or now<(self.cooldowns[player] or 0) then return end
        if not self:valid(player) then self.notify(player,"goDock");return end
        if Util.count(p.data.items)>=Config.InventoryLimit then self.notify(player,"full");return end
        local bite,reel=self.domain.buffs(p.data)
        self.sessions[player]=Machine.begin(now,self.random:NextNumber(Config.Fishing.BiteMin,Config.Fishing.BiteMax)*bite,reel)
        self.remote:FireClient(player,{phase="Charge",progress=0,power=0})
    elseif s and self:valid(player) then
        if Machine.input(s,action,now) then self:cast(player,s) end
    end
end
function Service:cast(player,s)
    local p,root=self.zones:position(player)
    local target=self.zones.rules.castTarget(p,s.power,Config.Fishing)
    if not target then self:cancel(player,false);return end
    s.target=Vector3.new(unpack(target));s.startPosition=root.Position+Vector3.new(0,2,0)
    local bobber=Instance.new("Part");bobber.Name="Bobber_"..player.UserId;bobber.Shape=Enum.PartType.Ball;bobber.Size=Vector3.new(.7,.7,.7)
    bobber.Anchored=true;bobber.CanCollide=false;bobber.CanTouch=false;bobber.CanQuery=false
    bobber.Color=Color3.fromRGB(255,150,45);bobber.Position=s.startPosition
    local a=Instance.new("Attachment");a.Parent=bobber
    local beam=Instance.new("Beam");beam.Attachment0=player.Character[self.zones.config.rodName].Handle.Tip;beam.Attachment1=a
    beam.Width0=.05;beam.Width1=.04;beam.FaceCamera=true;beam.Color=ColorSequence.new(Color3.new(1,1,1));beam.Parent=bobber
    bobber.Parent=workspace;s.bobber=bobber
end
function Service:tick(dt)
    local now=os.clock()
    for player,s in pairs(self.sessions) do
        if not self:valid(player) or (s.target and (not s.bobber or not s.bobber.Parent)) then self:cancel(player,false);continue end
        if s.phase=="Flight" then
            local alpha=math.clamp((now-s.changedAt)/Config.Fishing.FlightSeconds,0,1)
            s.bobber.Position=s.startPosition:Lerp(s.target,alpha)
            if alpha>=1 then
                -- Actual server position + bounded water rectangle + physical lake raycast.
                if not self.zones:landed(s.bobber,s.target) then self:cancel(player,false);continue end
                s.landed=true
            end
        end
        Machine.step(s,now,dt)
        if s.phase=="Success" then
            if not s.landed then self:cancel(player,false);continue end
            self:cancel(player,true);self.pending[player]=true
            self.remote:FireClient(player,{phase="Saving"})
            -- Choose ONCE before any yielding. All retries use the same reward/id/seed.
            local reward=self.rewards.prepare(self.random:NextNumber(),HttpService:GenerateGUID(false),self.random:NextInteger(1,2147483646),os.time())
            task.spawn(function()
                local p=self.store.profiles[player];local deadline=os.clock()+12
                while p and p.busy and os.clock()<deadline do task.wait(.1) end
                local ok,reason=self.store:transaction(player,function(data) return self.rewards.grant(data,reward) end)
                self.pending[player]=nil
                if ok then
                    self.onReward(player)
                    if player.Parent then self.remote:FireClient(player,{phase="Success",species=reward.species,id=reward.id}) end
                elseif player.Parent then self.notify(player,reason);self.remote:FireClient(player,{phase="Failed"}) end
            end)
        elseif s.phase=="Failed" then self:cancel(player,false)
        else self.remote:FireClient(player,{phase=s.phase,progress=s.progress,taps=s.taps,remaining=s.deadline and math.max(0,s.deadline-now) or 0,
            power=s.power or math.clamp((now-s.started)/Config.Fishing.ChargeSeconds,0,1)}) end
    end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Lease</string>
          <string name="Source"><![CDATA[-- Pure UpdateAsync transformations; nil means refuse, never overwrite another session.
local Lease = {}
function Lease.acquire(old, token, now, ttl, defaultData)
    if old and old.lock and old.lock.token ~= token and old.lock.expires > now then return nil end
    return {data = old and old.data or defaultData, lock = {token = token, expires = now+ttl}}
end
function Lease.write(old, token, now, ttl, data, release)
    if not old or not old.lock or old.lock.token ~= token or old.lock.expires <= now then return nil end
    -- Idempotent retry of the exact same revision is allowed.
    if old.data.revision > data.revision then return nil end
    return {data = data, lock = not release and {token = token, expires = now+ttl} or nil}
end
return Lease
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local Shared=ReplicatedStorage:WaitForChild("Shared")
local Config=require(Shared.Config)
local Util=require(Shared.Util)
local Domain=require(Shared.Domain).new(Config,require(Shared.Catalog),Util)
local Debug=require(script.Parent.StudioTools)
local Zones=require(script.Parent.ZoneService).new()
local World=require(script.Parent.WorldService).new(Zones)
local Rewards=require(script.Parent.RewardService).new(Domain,Config,Util)
assert(not ReplicatedStorage:FindFirstChild("Remotes"),"Duplicate FILAMENT server bootstrap")
local remotes=Instance.new("Folder");remotes.Name="Remotes"
local function remote(name) local r=Instance.new("RemoteEvent");r.Name=name;r.Parent=remotes;return r end
local Action=remote("Action");local Input=remote("FishingInput");local State=remote("FishingState")
local Snapshot=remote("Snapshot");local Notice=remote("Notice");local SaveStatus=remote("SaveStatus");local OpenPanel=remote("OpenPanel")
remotes.Parent=ReplicatedStorage
local function tell(player,key) if player.Parent then Notice:FireClient(player,key) end end
local Store=require(script.Parent.ProfileStore).new(Domain,function(player,status) if player.Parent then SaveStatus:FireClient(player,status) end end)
local counters={}
local function sync(player)
    local p=Store.profiles[player];if not p or not player.Parent then return end
    local data=Util.clone(p.data)
    for _,item in pairs(data.items) do item.seed=nil;item.ownerUserId=player.UserId end
    data.plotId=World.plots[player];data.saveStatus=p.status;data.serverTime=os.time()
    data.debugEnabled=Debug.enabled(RunService:IsStudio(),Config.StudioDebug);data.sessionStats=counters[player] or {catches=0,debug=0}
    Snapshot:FireClient(player,data);World:sync(player,p.data)
end
local Fishing=require(script.Parent.FishingService).new(Store,Domain,Rewards,Zones,State,function(player)
    if counters[player] then counters[player].catches+=1 end
    sync(player)
end,tell)
local buckets={}
local function allow(player,lane,rate,capacity)
    buckets[player]=buckets[player] or {};local now=os.clock()
    local b=buckets[player][lane] or {tokens=capacity,at=now}
    b.tokens=math.min(capacity,b.tokens+(now-b.at)*rate);b.at=now;buckets[player][lane]=b
    if b.tokens<1 then return false end;b.tokens-=1;return true
end
local function hatch(player)
    local p=Store.profiles[player];if not p or p.closed or p.busy then return end
    local ready=false
    for _,item in pairs(p.data.items) do if item.kind=="egg" and item.location=="aquarium" and item.readyAt<=os.time() then ready=true;break end end
    if not ready then return end
    local ok=Store:transaction(player,function(data) local results=Rewards.hatch(data,os.time());return #results>0,results end)
    if ok then sync(player);tell(player,"hatched") end
end
Input.OnServerEvent:Connect(function(player,action)
    if type(action)~="string" or #action>20 or not allow(player,"input",22,30) then return end
    if action=="start" or action=="release" or action=="hold" or action=="stopHold" or action=="tap" or action=="cancel" then Fishing:input(player,action) end
end)
Action.OnServerEvent:Connect(function(player,action,id,option)
    if type(action)~="string" or #action>24 or (id~=nil and (type(id)~="string" or #id>64)) or (option~=nil and (type(option)~="string" or #option>20)) then return end
    if not allow(player,"action",2,5) then return end
    local profile=Store.profiles[player];if not profile or profile.closed then tell(player,"notReady");return end
    if action=="sync" then sync(player);return end
    local position,root=Zones:position(player);if not root then tell(player,"notReady");return end
    if action=="rod" then
        local rod=player.Backpack:FindFirstChild(Zones.config.rodName)
        if rod then player.Character:FindFirstChildOfClass("Humanoid"):EquipTool(rod) end
        return
    end
    if action=="travel" then
        if not Debug.enabled(RunService:IsStudio(),Config.StudioDebug) or not allow(player,"travel",.5,1) then return end
        local destination=id=="aquarium" and World.plots[player] or id
        local permitted={SpawnPlaza=true,FishingDock=true,FishMarket=true,FeedWorkshop=true,AquariumGarden=true}
        if id~="aquarium" and not permitted[id] then return end
        local zone=Zones.config.zones[destination];if not zone then return end
        Fishing:cancel(player,true);State:FireClient(player,{phase="Idle"})
        local v=Vector3.new(unpack(zone.arrival));player.Character:PivotTo(CFrame.lookAt(v,v+Vector3.new(0,0,-1)))
        return
    end
    if string.sub(action,1,5)=="debug" then
        if not Debug.enabled(RunService:IsStudio(),Config.StudioDebug) then return end
        if Fishing:busy(player) then tell(player,"finishFishing");return end
        local ok,reason=Store:transaction(player,function(data)
            return Debug.apply(data,action,option,os.time(),Domain,function() return HttpService:GenerateGUID(false) end,
                function() return Random.new():NextInteger(1,2147483646) end,RunService:IsStudio(),Config.StudioDebug,Config.Aquarium)
        end)
        if ok then counters[player].debug+=1;sync(player);hatch(player) end
        tell(player,reason);return
    end
    if Fishing:busy(player) then tell(player,"finishFishing");return end
    local allowed,reason=Zones.rules.authorize(action,position,World.plots[player])
    if not allowed then tell(player,reason);return end
    local ok,result=Store:transaction(player,function(data) return Domain.apply(data,action,id,option,os.time()) end)
    if ok then sync(player) end;tell(player,result)
end)
for id,zone in pairs(Zones.config.zones) do
    if zone.type=="market" or zone.type=="workshop" or zone.type=="plot" then
        Zones.world[id].Console.Prompt.Triggered:Connect(function(player)
            if not Store.profiles[player] or not allow(player,"prompt",2,3) then return end
            if zone.type=="plot" and World.plots[player]~=id then return end
            if not Zones.rules.interact(id,Zones:position(player)) then return end
            OpenPanel:FireClient(player,zone.type=="plot" and "tank" or "fish")
        end)
    end
end
local function joined(player)
    if counters[player] then return end
    counters[player]={catches=0,debug=0}
    if not World:assign(player) then player:Kick("FILAMENT: 16 plots are occupied.");return end
    local function characterAdded()
        Fishing:cancel(player,true);State:FireClient(player,{phase="Idle"})
        task.wait(.4);World:rod(player);sync(player)
    end
    player.CharacterAdded:Connect(characterAdded);if player.Character then task.spawn(characterAdded) end
    local profile=Store:load(player)
    if profile then
        if not player.Parent then Store:release(player);World:release(player);return end
        hatch(player);sync(player)
    end
end
Players.PlayerAdded:Connect(joined);for _,p in ipairs(Players:GetPlayers()) do task.spawn(joined,p) end
Players.PlayerRemoving:Connect(function(player)
    Fishing:cancel(player,true);Fishing.cooldowns[player]=nil;Fishing.pending[player]=nil
    buckets[player]=nil;counters[player]=nil;World:release(player);Store:release(player)
end)
task.spawn(function()
    while not Store.closing do
        task.wait(1)
        for player in pairs(Store.profiles) do task.spawn(function() hatch(player);Store:renew(player) end) end
    end
end)
game:BindToClose(function()
    Store.closing=true;local count=0
    for player in pairs(Store.profiles) do count+=1;task.spawn(function() Store:release(player);count-=1 end) end
    local deadline=os.clock()+25;while count>0 and os.clock()<deadline do task.wait(.1) end
end)
print("[FILAMENT] Functional Blockout "..Config.Version.." / "..(Store.memory and "STUDIO MEMORY" or "DATASTORE"))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PlotRegistry</string>
          <string name="Source"><![CDATA[-- Session plot allocation. Data belongs to a player profile, never to a plot number.
local Registry={};Registry.__index=Registry
function Registry.new(config)
    local ids={};for id,zone in pairs(config.zones) do if zone.type=="plot" then table.insert(ids,id) end end;table.sort(ids)
    return setmetatable({ids=ids,plots={},owners={}},Registry)
end
function Registry:assign(owner)
    if self.plots[owner] then return self.plots[owner] end
    for _,id in ipairs(self.ids) do if self.owners[id]==nil then self.owners[id]=owner;self.plots[owner]=id;return id end end
    return nil
end
function Registry:release(owner)
    local id=self.plots[owner]
    if id and self.owners[id]==owner then self.owners[id]=nil end
    self.plots[owner]=nil
end
return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Lease = require(script.Parent.Lease)
local Store = {}
Store.__index = Store

function Store.new(domain, notify)
    local memory = RunService:IsStudio() and not Config.StudioPersistence
    local self = setmetatable({profiles = {}, domain = domain, notify = notify, memory = memory, closing = false}, Store)
    if not memory then
        self.backend = DataStoreService:GetDataStore(Config.DataStoreName .. (RunService:IsStudio() and "_Studio" or "_Live"))
    else
        warn("[FILAMENT] STUDIO MEMORY MODE: data will reset when Stop is pressed. No cloud save is attempted.")
    end
    return self
end
function Store:attempt(callback)
    local lastError
    for attempt = 1, Config.SaveAttempts do
        local ok, result = pcall(callback)
        if ok then return true, result end
        lastError = result
        warn(string.format("[FILAMENT] DataStore attempt %d failed: %s", attempt, tostring(result)))
        if attempt < Config.SaveAttempts then task.wait(2^(attempt-1)) end
    end
    return false, lastError
end
function Store:load(player)
    local token = HttpService:GenerateGUID(false)
    local data = self.domain.default()
    if not self.memory then
        local ok, record = self:attempt(function()
            return self.backend:UpdateAsync("player_"..player.UserId, function(old)
                return Lease.acquire(old, token, os.time(), Config.LeaseSeconds, data)
            end)
        end)
        if not ok or not record or not record.lock or record.lock.token ~= token then
            player:Kick("FILAMENT: 저장 데이터를 불러오지 못했습니다. 다른 세션이 종료된 후 잠시 뒤 다시 접속해 주세요. / Data unavailable or session locked.")
            return nil
        end
        data = record.data
    end
    if not self.domain.valid(data) then
        warn("[FILAMENT] Refusing unsupported/corrupt profile", player.UserId)
        player:Kick("FILAMENT: 저장 데이터 검증 실패. 덮어쓰지 않았습니다. / Invalid save; not overwritten.")
        return nil
    end
    local profile = {data = data, token = token, busy = false, closed = false, lastSave = os.time(), status = self.memory and "memory" or "saved"}
    self.profiles[player] = profile
    return profile
end
function Store:write(player, profile, candidate, release)
    if self.memory then return true end
    self.notify(player, "saving")
    local ok, record = self:attempt(function()
        return self.backend:UpdateAsync("player_"..player.UserId, function(old)
            return Lease.write(old, profile.token, os.time(), Config.LeaseSeconds, candidate, release)
        end)
    end)
    if not ok or not record or record.data.revision ~= candidate.revision or (not release and (not record.lock or record.lock.token ~= profile.token)) then
        profile.status = "error"
        profile.closed = true
        self.notify(player, "error")
        warn("[FILAMENT] Save failed/lock lost; session frozen to prevent divergent writes", player.UserId)
        task.delay(2, function()
            if player.Parent then player:Kick("FILAMENT: 저장 오류로 세션을 중지했습니다. 잠시 후 재접속해 주세요. / Save failed; reconnect shortly.") end
        end)
        return false
    end
    profile.lastSave = os.time()
    return true
end
function Store:transaction(player, mutate)
    local p = self.profiles[player]
    if not p or p.closed or self.closing then return false, "notReady" end
    if p.busy then return false, "busy" end
    p.busy = true
    local candidate = Util.clone(p.data)
    local ran, changed, result = pcall(mutate, candidate)
    if not ran then
        warn("[FILAMENT] Transaction exception", changed)
        p.busy = false
        return false, "serverError"
    end
    if not changed then p.busy = false; return false, result end
    candidate.revision += 1
    if not self.domain.valid(candidate) then
        p.busy = false
        warn("[FILAMENT] Rejected invalid transaction")
        return false, "serverError"
    end
    if not self:write(player, p, candidate, false) then p.busy = false; return false, "saveError" end
    p.data = candidate -- publish only after a durable commit (or explicit Studio memory mode).
    p.status = self.memory and "memory" or "saved"
    p.busy = false
    self.notify(player, p.status)
    return true, result
end
function Store:renew(player)
    local p = self.profiles[player]
    if not p or p.closed or p.busy or self.memory or os.time()-p.lastSave < Config.RenewSeconds then return end
    p.busy = true
    if self:write(player, p, p.data, false) then p.status = "saved"; self.notify(player, "saved") end
    p.busy = false
end
function Store:release(player)
    local p = self.profiles[player]
    if not p then return end
    local deadline = os.clock()+20
    while p.busy and os.clock() < deadline do task.wait(0.1) end
    if not p.busy and not p.closed then
        p.busy = true
        self:write(player, p, p.data, true)
        p.closed = true
    end
    self.profiles[player] = nil
end
return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[-- Server-only reward adapter. Fishing V2 can replace input without touching inventory.
local RewardService={}
function RewardService.new(domain,config,util)
    local self={}
    function self.prepare(unit,id,seed,now)
        return {species=util.roll(config.CatchTable,unit),id=id,seed=seed,at=now}
    end
    function self.grant(data,reward)
        local ok,reason=domain.grant(data,reward.species,reward.id,reward.seed,reward.at)
        if ok then data.items[reward.id].source="fishing" end
        return ok,reason
    end
    function self.hatch(data,now)
        local origins={}
        for id,item in pairs(data.items) do if item.kind=="egg" then origins[id]=item.source or "legacy" end end
        local results=domain.hatch(data,now)
        for id,source in pairs(origins) do if data.items[id].kind=="pet" then data.items[id].source=source end end
        return results
    end
    return self
end
return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">StudioTools</string>
          <string name="Source"><![CDATA[-- No Remote can supply arbitrary amounts/species. Every operation is gated here.
local StudioTools={}
function StudioTools.enabled(isStudio,configured) return isStudio==true and configured==true end
function StudioTools.apply(data,action,option,now,domain,newId,newSeed,isStudio,configured,levels)
    if not StudioTools.enabled(isStudio,configured) then return false,"invalid" end
    if action=="debugFish" or action=="debugEgg" then
        local species=action=="debugFish" and {"silver","sunny","azure"} or {"tideEgg"}
        -- The store runs this on a disposable candidate; failure cannot partially publish.
        for _,name in ipairs(species) do
            local id=newId();local ok,reason=domain.grant(data,name,id,newSeed(),now)
            if not ok then return false,reason end
            data.items[id].source="studioDebug"
        end
    elseif action=="debugFeed" then data.feed.basic+=3;data.feed.premium+=3
    elseif action=="debugCoins" then data.coins+=500
    elseif action=="debugLevel" then
        local level=tonumber(option)
        if not level or level%1~=0 or level<1 or level>#levels then return false,"invalid" end
        if domain.occupied(data)>levels[level].capacity then return false,"tankFull" end
        data.aquariumLevel=level
    elseif action=="debugHatch" then
        for _,item in pairs(data.items) do
            if item.kind=="egg" and item.location=="aquarium" then
                local duration=item.readyAt-item.startedAt
                item.readyAt=now;item.startedAt=now-duration;item.source="studioDebug"
            end
        end
    else return false,"invalid" end
    return true,"debugDone"
end
return StudioTools
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[local Shared=game:GetService("ReplicatedStorage").Shared
local Catalog=require(Shared.Catalog)
local Models=require(Shared.Models)
local Registry=require(script.Parent.PlotRegistry)
local WorldService={};WorldService.__index=WorldService
function WorldService.new(zones)
    local registry=Registry.new(zones.config)
    local self=setmetatable({zones=zones,registry=registry,plots=registry.plots,visuals=Instance.new("Folder")},WorldService)
    self.visuals.Name="CollectionVisuals";self.visuals.Parent=workspace
    return self
end
function WorldService:assign(player)
    local id=self.registry:assign(player)
    if not id then return nil end
    self.zones.world[id]:SetAttribute("OwnerUserId",player.UserId)
    if not self.visuals:FindFirstChild(tostring(player.UserId)) then
        local group=Instance.new("Folder");group.Name=tostring(player.UserId);group.Parent=self.visuals
    end
    return id
end
function WorldService:sync(player,data)
    local id=self.plots[player];if not id then return end
    local node=self.zones.world[id]
    node.OwnerSign.Label.Text.Text=id.."\n"..player.DisplayName.." · Lv."..data.aquariumLevel
    local group=self.visuals:FindFirstChild(tostring(player.UserId));if not group then return end
    local ids,desired={},{}
    for itemId,item in pairs(data.items) do if item.location=="aquarium" then table.insert(ids,itemId) end end
    table.sort(ids)
    for index,itemId in ipairs(ids) do
        desired[itemId]=true
        local item=data.items[itemId];local model=group:FindFirstChild(itemId)
        if not model then
            model=Models.make(item.kind,item.species,Catalog[item.species].color);model.Name=itemId
            model:SetAttribute("ItemId",itemId);model:SetAttribute("OwnerUserId",player.UserId);model:SetAttribute("VisualKind",item.kind)
            model.Parent=group
        end
        local p=Vector3.new(unpack(self.zones.rules.slot(id,index)))
        model:SetAttribute("SlotPosition",p);model:SetAttribute("SlotIndex",index);model:PivotTo(CFrame.new(p))
    end
    local pet=data.items[data.equippedPet];local follower=group:FindFirstChild("EquippedPet")
    if follower and (not pet or follower:GetAttribute("ItemId")~=pet.id) then follower:Destroy();follower=nil end
    if pet then
        desired.EquippedPet=true
        if not follower then
            follower=Models.make("pet",pet.species,Catalog[pet.species].color);follower.Name="EquippedPet"
            follower:SetAttribute("VisualKind","follower");follower:SetAttribute("OwnerUserId",player.UserId);follower:SetAttribute("ItemId",pet.id)
            local _,root=self.zones:position(player)
            follower:PivotTo(root and root.CFrame or CFrame.new(unpack(self.zones.config.zones[id].arrival)))
            follower.Parent=group
        end
    end
    for _,m in ipairs(group:GetChildren()) do if not desired[m.Name] then m:Destroy() end end
end
function WorldService:release(player)
    local id=self.plots[player]
    if id then
        self.zones.world[id]:SetAttribute("OwnerUserId",nil)
        self.zones.world[id].OwnerSign.Label.Text.Text=id.."\nVACANT / 비어 있음"
        self.registry:release(player)
    end
    local group=self.visuals:FindFirstChild(tostring(player.UserId));if group then group:Destroy() end
end
function WorldService:rod(player)
    local char=player.Character;local bag=player:WaitForChild("Backpack",10)
    if not char or not bag then return end
    local name=self.zones.config.rodName
    if char:FindFirstChild(name) or bag:FindFirstChild(name) then return end
    local tool=Instance.new("Tool");tool.Name=name;tool.ToolTip="낚싯대 / Fishing rod";tool.CanBeDropped=false
    local handle=Instance.new("Part");handle.Name="Handle";handle.Size=Vector3.new(.18,4,.18)
    handle.Color=Color3.fromRGB(117,80,46);handle.CanCollide=false;handle.CanTouch=false;handle.Massless=true;handle.Parent=tool
    local tip=Instance.new("Attachment");tip.Name="Tip";tip.Position=Vector3.new(0,2,0);tip.Parent=handle
    tool.Grip=CFrame.new(0,-1.4,0);tool.Parent=bag
    local human=char:FindFirstChildOfClass("Humanoid");if human then human:EquipTool(tool) end
end
return WorldService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.ZoneConfig)
local Rules=require(Shared.Zones).new(Config)
local ZoneService={}
ZoneService.__index=ZoneService
function ZoneService.new()
    local self=setmetatable({config=Config,rules=Rules,world=workspace:WaitForChild("World"):WaitForChild("Zones")},ZoneService)
    for id,z in pairs(Config.zones) do
        local node=self.world:WaitForChild(id);local floor=node:WaitForChild("Floor")
        assert((floor.Position-Vector3.new(unpack(z.position))).Magnitude<.01,"Zone position differs: "..id)
        assert((floor.Size-Vector3.new(unpack(z.size))).Magnitude<.01,"Zone size differs: "..id)
        node:SetAttribute("ZoneId",id);node:SetAttribute("ZoneType",z.type)
    end
    self.raycast=RaycastParams.new();self.raycast.FilterType=Enum.RaycastFilterType.Include
    -- Include only physical surface parts; safety colliders are deliberately excluded.
    self.raycast.FilterDescendantsInstances={self.world.FishingLake.Floor,self.world.FishingDock.Floor}
    return self
end
function ZoneService:position(player)
    local char=player.Character;local human=char and char:FindFirstChildOfClass("Humanoid")
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not human or human.Health<=0 or not root then return nil end
    return {root.Position.X,root.Position.Y,root.Position.Z},root
end
function ZoneService:landed(bobber,target)
    if not bobber or not bobber.Parent or (bobber.Position-target).Magnitude>.2 then return false end
    local p={bobber.Position.X,bobber.Position.Y,bobber.Position.Z}
    if not self.rules.waterTarget(p) then return false end
    local hit=workspace:Raycast(bobber.Position+Vector3.new(0,6,0),Vector3.new(0,-10,0),self.raycast)
    return hit~=nil and hit.Instance==self.world.FishingLake.Floor and math.abs(bobber.Position.Y-hit.Position.Y-.35)<.1
end
return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="25">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="29">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Basic display only: one simple model per item; no effects, previews or decoration.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local localPlayer=Players.LocalPlayer
local visuals=workspace:WaitForChild("CollectionVisuals")
local tracked={}
local function add(m) if m:IsA("Model") and m:GetAttribute("VisualKind") then tracked[m]=true end end
for _,m in ipairs(visuals:GetDescendants()) do add(m) end
visuals.DescendantAdded:Connect(add);visuals.DescendantRemoving:Connect(function(m) tracked[m]=nil end)
-- Visibility is a convenience; the server independently checks ownership and distance.
for _,node in ipairs(workspace:WaitForChild("World"):WaitForChild("Zones"):GetChildren()) do
    if string.sub(node.Name,1,12)=="AquariumPlot" then
        local prompt=node:WaitForChild("Console"):WaitForChild("Prompt")
        local function refresh() prompt.Enabled=node:GetAttribute("OwnerUserId")==localPlayer.UserId end
        node:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh);refresh()
    end
end
local elapsed=0
RunService.RenderStepped:Connect(function(dt)
    elapsed+=dt;if elapsed<.05 then return end
    local step=elapsed;elapsed=0;local now=workspace:GetServerTimeNow()
    for m in pairs(tracked) do
        if not m.Parent then tracked[m]=nil;continue end
        if m:GetAttribute("VisualKind")=="follower" then
            local owner=Players:GetPlayerByUserId(m:GetAttribute("OwnerUserId"));local root=owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local target=root.CFrame*CFrame.new(2.5,.5,3)
                m:PivotTo((m:GetPivot().Position-target.Position).Magnitude>30 and target or m:GetPivot():Lerp(target,1-math.exp(-8*step)))
            end
        elseif m:GetAttribute("VisualKind")=="fish" then
            local p=m:GetAttribute("SlotPosition")
            if p then m:PivotTo(CFrame.new(p+Vector3.new(math.sin(now+(m:GetAttribute("SlotIndex") or 0))*.5,0,0))) end
        end
    end
end)
local function camera(character)
    local root=character:WaitForChild("HumanoidRootPart",8);local human=character:WaitForChild("Humanoid",8)
    if not root or not human then return end
    RunService.RenderStepped:Wait();local c=workspace.CurrentCamera
    if c and localPlayer.Character==character then
        c.CameraType=Enum.CameraType.Scriptable;c.CameraSubject=human
        c.CFrame=CFrame.lookAt(root.Position+Vector3.new(0,10,18),root.Position+Vector3.new(0,0,-20));c.Focus=root.CFrame
        RunService.RenderStepped:Wait();c.CameraType=Enum.CameraType.Custom
    end
end
localPlayer.CharacterAdded:Connect(camera);if localPlayer.Character then task.spawn(camera,localPlayer.Character) end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="30">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Phase 0.2: one plain bag panel and one contextual fishing meter. No previews.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local GuiService=game:GetService("GuiService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local Shared=ReplicatedStorage:WaitForChild("Shared")
local Config=require(Shared.Config)
local ZoneConfig=require(Shared.ZoneConfig)
local Zones=require(Shared.Zones).new(ZoneConfig)
local Catalog=require(Shared.Catalog)
local Domain=require(Shared.Domain).new(Config,Catalog,require(Shared.Util))
local Presentation=require(Shared.Presentation)
local Layout=require(Shared.Layout)
local Strings=require(Shared.Strings)
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local Action=remotes:WaitForChild("Action");local Input=remotes:WaitForChild("FishingInput")
local locale=string.sub(player.LocaleId,1,2)=="ko" and "ko" or "en"
local function t(key) return Strings[locale][key] or Strings.en[key] or tostring(key) end
local data,snapshotAt=nil,0
local phase={phase="Idle"}
local tab,selected,quality,context="fish",nil,"none","bag"
local debugOpen,coreMenu=false,false
local held,pointer,charging=false,nil,false
local timers={};local noticeVersion=0;local nextAction=0
local touch=UIS.TouchEnabled
local C={panel=Color3.fromRGB(242,243,245),text=Color3.fromRGB(30,35,43),muted=Color3.fromRGB(84,92,104),button=Color3.fromRGB(214,221,231),accent=Color3.fromRGB(236,161,74),disabled=Color3.fromRGB(202,204,209)}
local function make(class,parent,props)
    local object=Instance.new(class);for k,v in pairs(props or {}) do object[k]=v end;object.Parent=parent;return object
end
local function frame(parent,props)
    props.BorderSizePixel=0;props.BackgroundColor3=props.BackgroundColor3 or C.panel;return make("Frame",parent,props)
end
local function text(parent,value,pos,size,fontSize)
    return make("TextLabel",parent,{Text=value,Position=pos,Size=size,TextSize=fontSize or 15,TextColor3=C.text,BackgroundTransparency=1,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.Gotham})
end
local function button(parent,value,pos,size,callback,enabled)
    local b=make("TextButton",parent,{Text=value,Position=pos,Size=size,TextSize=15,TextColor3=C.text,Font=Enum.Font.Gotham,TextWrapped=true,BorderSizePixel=0,
        BackgroundColor3=enabled==false and C.disabled or C.button,Active=enabled~=false,AutoButtonColor=enabled~=false})
    if callback then b.Activated:Connect(function() if b.Active then callback() end end) end
    return b
end
local playerGui=player:WaitForChild("PlayerGui")
assert(not playerGui:FindFirstChild("FilamentBlockout"),"Duplicate FILAMENT client")
local gui=make("ScreenGui",playerGui,{Name="FilamentBlockout",ResetOnSpawn=false,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets,ClipToDeviceSafeArea=true,DisplayOrder=10,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
local hud=make("ScreenGui",playerGui,{Name="FilamentBlockoutHUD",ResetOnSpawn=false,ScreenInsets=Enum.ScreenInsets.TopbarSafeInsets,ClipToDeviceSafeArea=true,DisplayOrder=10})
local coins=text(hud,"—",UDim2.new(1,-238,0,10),UDim2.fromOffset(136,44),16);coins.BackgroundTransparency=.05;coins.BackgroundColor3=C.panel;coins.TextXAlignment=Enum.TextXAlignment.Center
local bag=button(hud,t("bag"),UDim2.new(1,-94,0,10),UDim2.fromOffset(84,44))
local modal=frame(gui,{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(35,40,48),BackgroundTransparency=.4,Visible=false,Active=true,ZIndex=10})
local panel=frame(modal,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5)})
local title=text(panel,t("bag"),UDim2.fromOffset(12,4),UDim2.new(1,-120,0,44),18)
local close=button(panel,"×",UDim2.new(1,-52,0,4),UDim2.fromOffset(44,44))
local help=button(panel,"?",UDim2.new(1,-102,0,4),UDim2.fromOffset(44,44))
local tabs=frame(panel,{Position=UDim2.fromOffset(8,54),Size=UDim2.new(1,-16,0,44),BackgroundTransparency=1})
local tabButtons={}
local meta=text(panel,"",UDim2.fromOffset(12,102),UDim2.new(1,-24,0,56),14)
local body=make("ScrollingFrame",panel,{Position=UDim2.fromOffset(12,164),Size=UDim2.new(1,-24,1,-176),BackgroundTransparency=1,BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=4,ScrollingDirection=Enum.ScrollingDirection.Y})
local stack=make("UIListLayout",body,{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder})
local meter=frame(gui,{AnchorPoint=Vector2.new(.5,0),Position=UDim2.fromScale(.5,.5),Visible=false})
local meterTitle=text(meter,"",UDim2.fromOffset(10,4),UDim2.new(1,-20,0,26),15)
local track=frame(meter,{Position=UDim2.fromOffset(10,34),Size=UDim2.new(1,-20,0,14),BackgroundColor3=C.button})
local fill=frame(track,{Size=UDim2.fromScale(0,1),BackgroundColor3=Color3.fromRGB(60,142,202)})
local meterHelp=text(meter,"",UDim2.fromOffset(10,52),UDim2.new(1,-20,0,34),14)
local hint=button(gui,"",UDim2.new(),UDim2.fromOffset(300,34));hint.AnchorPoint=Vector2.new(.5,0);hint.Visible=false
local control=button(gui,"",UDim2.new(),UDim2.fromOffset(64,64));control.BackgroundColor3=C.accent;control.Visible=false
local cancel=button(gui,"×",UDim2.new(),UDim2.fromOffset(44,44));cancel.Visible=false
local waiting=text(gui,"",UDim2.new(),UDim2.fromOffset(270,36),15);waiting.AnchorPoint=Vector2.new(.5,0);waiting.BackgroundColor3=C.panel;waiting.BackgroundTransparency=.05;waiting.TextXAlignment=Enum.TextXAlignment.Center;waiting.Visible=false
local toast=text(gui,"",UDim2.new(.5,0,0,64),UDim2.fromOffset(360,58),15);toast.AnchorPoint=Vector2.new(.5,0);toast.BackgroundTransparency=0;toast.BackgroundColor3=C.panel;toast.TextXAlignment=Enum.TextXAlignment.Center;toast.Visible=false;toast.ZIndex=20
local metrics=Layout.metrics(800,600,touch)
local render,updateFishing
local function notify(value)
    noticeVersion+=1;local version=noticeVersion
    toast.Text=value;toast.Visible=not coreMenu
    task.delay(3,function() if version==noticeVersion then toast.Visible=false end end)
end
local function release()
    held=false;pointer=nil
    if charging then Input:FireServer("release");charging=false end
    Input:FireServer("stopHold")
end
local function stopInput()
    release()
    if phase.phase~="Idle" and phase.phase~="Success" and phase.phase~="Failed" and phase.phase~="Saving" then Input:FireServer("cancel") end
end
local function position()
    local r=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    return r and {r.Position.X,r.Position.Y,r.Position.Z} or nil
end
local function equipped() return player.Character and player.Character:FindFirstChild(ZoneConfig.rodName)~=nil end
local function send(action,id,option)
    if os.clock()<nextAction then return end;nextAction=os.clock()+.45
    Action:FireServer(action,id,option)
end
local function row(value,height)
    local l=text(body,value,UDim2.new(),UDim2.new(1,-8,0,height or 0),15)
    if not height then l.AutomaticSize=Enum.AutomaticSize.Y end
    return l
end
local function rowButton(value,callback,enabled,height) return button(body,value,UDim2.new(),UDim2.new(1,-8,0,height or 46),callback,enabled) end
local function closeBag() modal.Visible=false;updateFishing() end
local function openBag(which)
    stopInput();tab=which or tab;selected=nil;modal.Visible=true;context=Zones.context(position(),data and data.plotId)
    body.CanvasPosition=Vector2.zero;render();updateFishing()
end
local function back() selected=nil;body.CanvasPosition=Vector2.zero;render() end
local function selectedItem(item)
    rowButton("‹ "..t("backList"),back)
    local d=Catalog[item.species]
    row(t(item.species).." · "..t(d.rarity).."\n"..t(item.location=="aquarium" and "placedState" or "bagState"))
    row(t("itemSource")..": "..t(item.source or "legacy").." · ID "..string.sub(item.id,1,8))
    if item.kind=="fish" then
        row(t("price")..": "..d.value.." · "..t("basic").." ×"..d.basicYield.." / "..t("premium").." ×"..d.premiumYield)
    elseif item.kind=="pet" then
        row(t("bite").." −"..math.floor((1-d.biteMultiplier)*100+.5).."%\n"..t("efficiency").." +"..math.floor((d.reelMultiplier-1)*100+.5).."%")
    elseif item.location=="aquarium" then
        local label=row("",48);table.insert(timers,{label=label,at=item.readyAt})
        row(t(item.feedQuality).." · Lv."..item.incubationLevel.."\n"..t("lockedEgg"))
    elseif context=="aquarium" then
        row(t("feedTitle"))
        for _,q in ipairs({"none","basic","premium"}) do
            rowButton((quality==q and "✓ " or "")..t(q).." · "..Config.Feed[q].duration..t("seconds"),function() quality=q;render() end,q=="none" or data.feed[q]>0)
        end
        local weights=Domain.weights(data.aquariumLevel,quality,Config.Feed[quality].duration);local sum=0;local lines={}
        for _,w in ipairs(weights) do sum+=w.weight end
        for _,w in ipairs(weights) do table.insert(lines,t(w.id).." "..string.format("%.2f%%",w.weight/sum*100)) end
        row(table.concat(lines,"\n"));row(t("snapshotted"))
    end
    local actions=Presentation.actions(item,context,data.equippedPet,Catalog)
    for _,key in ipairs(actions) do
        local enabled=key~="place" or Domain.occupied(data)<Config.Aquarium[data.aquariumLevel].capacity
        rowButton(t(key),function()
            if key=="craftBasic" then send("craft",item.id,"basic")
            elseif key=="craftPremium" then send("craft",item.id,"premium")
            else send(key,item.id,item.kind=="egg" and quality or nil) end
        end,enabled)
    end
    if #actions==0 then row(t(item.kind=="egg" and item.location=="aquarium" and "lockedEgg" or "zoneHint")) end
end
local function helpPage()
    row(t("helpBody"));row(t("saveLabel")..": "..t(data and data.saveStatus or "loading"))
    if data then row(t("sessionChecks")..": "..data.sessionStats.catches.." / DEBUG "..data.sessionStats.debug) end
    rowButton(t("language"),function() locale=locale=="ko" and "en" or "ko";render();bag.Text=t("bag") end)
    rowButton(t("rodHelp"),function() send("rod") end)
    if data and data.debugEnabled then
        rowButton(t("debugToggle"),function() debugOpen=not debugOpen;render() end)
        if debugOpen then
            row(t("testNotice"))
            for _,key in ipairs({"debugFish","debugEgg","debugFeed","debugCoins","debugHatch"}) do rowButton(t(key),function() send(key) end) end
            for level=1,3 do rowButton("DEBUG Lv."..level,function() send("debugLevel",nil,tostring(level)) end) end
            for _,id in ipairs({"SpawnPlaza","FishingDock","FishMarket","FeedWorkshop","AquariumGarden","aquarium"}) do
                local titleText=id=="aquarium" and t("aquarium") or ZoneConfig.zones[id].label[locale]
                rowButton(t("travelLabel").." · "..titleText,function() send("travel",id);closeBag() end)
            end
        end
    end
end
render=function()
    if not modal.Visible then return end
    for _,child in ipairs(body:GetChildren()) do if child~=stack then child:Destroy() end end
    timers={};title.Text=t(tab=="help" and "help" or "bag")
    for key,b in pairs(tabButtons) do b.Text=t(key);b.BackgroundColor3=key==tab and C.accent or C.button end
    if not data then meta.Text=t("loading");return end
    title.Text=t(tab=="help" and "help" or "bag").." · "..data.coins.." "..t("coins")
    local zoneLabel=t(({shop="shop",craft="craft",aquarium="aquarium",bag="exploring"})[context])
    meta.Text=zoneLabel.." · "..(data.plotId or "").."\n"..t("basic").." "..data.feed.basic.." / "..t("premium").." "..data.feed.premium.." · Lv."..data.aquariumLevel
    if tab=="help" then helpPage();return end
    if selected and data.items[selected] then selectedItem(data.items[selected]);return end
    if tab=="tank" then
        local count=Domain.occupied(data);local lv=data.aquariumLevel;local cost=Config.Aquarium[lv].nextCost
        row(t("capacity")..": "..count.." / "..Config.Aquarium[lv].capacity.." · "..t("zoneHint"))
        if cost>0 then rowButton(t("upgrade").." · "..cost.." "..t("coins"),function() send("upgrade") end,context=="aquarium" and data.coins>=cost)
        else row(t("maxLevel")) end
    end
    local items={}
    for _,item in pairs(data.items) do
        if (tab=="fish" and item.kind=="fish") or (tab=="eggs" and item.kind=="egg") or (tab=="pets" and item.kind=="pet") or (tab=="tank" and item.location=="aquarium") then table.insert(items,item) end
    end
    table.sort(items,function(a,b) if a.obtainedAt==b.obtainedAt then return a.id<b.id end;return a.obtainedAt>b.obtainedAt end)
    if #items==0 then row(t("empty")) end
    for _,item in ipairs(items) do
        local state=item.id==data.equippedPet and t("equippedLabel") or t(item.location=="aquarium" and "placedState" or "bagState")
        local prefix=item.source=="studioDebug" and "[DEBUG] " or ""
        rowButton(prefix..t(item.species).." · "..t(Catalog[item.species].rarity).."\n"..state.." · "..string.sub(item.id,1,8),function() selected=item.id;body.CanvasPosition=Vector2.zero;render() end,true,66)
    end
end
for i,key in ipairs({"fish","eggs","pets","tank"}) do
    tabButtons[key]=button(tabs,t(key),UDim2.new((i-1)/4,2,0,0),UDim2.new(.25,-4,1,0),function() tab=key;back() end)
end
bag.Activated:Connect(function() if modal.Visible then closeBag() else openBag() end end)
close.Activated:Connect(closeBag);help.Activated:Connect(function() tab="help";selected=nil;render() end)
cancel.Activated:Connect(stopInput)
local function press(input)
    if modal.Visible or coreMenu or not data or not equipped() or pointer then return end
    if phase.phase=="Idle" and not Zones.canFish(position()) then notify(t("goDock"));return end
    local intent=Presentation.intent(phase.phase,held);if not intent then return end
    held=true;pointer=input;charging=intent=="start";Input:FireServer(intent)
end
for _,b in ipairs({hint,control}) do b.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then press(input) end
end) end
UIS.InputBegan:Connect(function(input,processed)
    if processed or UIS:GetFocusedTextBox() or coreMenu then return end
    if input.KeyCode==Enum.KeyCode.F then press(input)
    elseif input.KeyCode==Enum.KeyCode.B then if modal.Visible then closeBag() else openBag() end
    elseif input.KeyCode==Enum.KeyCode.R then send("rod") end
end)
UIS.InputEnded:Connect(function(input)
    if input==pointer or (pointer and input.KeyCode==Enum.KeyCode.F and pointer.KeyCode==Enum.KeyCode.F)
        or (pointer and input.UserInputType==Enum.UserInputType.MouseButton1 and pointer.UserInputType==Enum.UserInputType.MouseButton1) then release() end
end)
UIS.WindowFocusReleased:Connect(stopInput)
updateFishing=function()
    local state=phase.phase
    local v=Presentation.view(state,equipped(),Zones.canFish(position()),modal.Visible or coreMenu)
    meter.Visible=v.meter;hint.Visible=v.hint;control.Visible=v.action and (touch or state~="Idle");cancel.Visible=v.cancel;waiting.Visible=v.waiting
    hint.Text=t(Zones.canFish(position()) and "idleHint" or "goDock")
    control.Text=t(state=="Reel" and "holdShort" or (state=="Resist" and "tapShort" or "castShort"))
    waiting.Text=t(state=="Saving" and "savingCatch" or (state=="Flight" and "flight" or "waiting"))
    local value=phase.progress or 0
    if state=="Charge" then value=phase.power or 0;meterTitle.Text=t("power").." "..math.floor(value*100).."%";meterHelp.Text=t("releaseHint")
    elseif state=="Resist" then value=(phase.taps or 0)/Config.Fishing.ResistanceTaps;meterTitle.Text=t("resistance").." "..(phase.taps or 0).."/9 · "..string.format("%.1f",phase.remaining or 0)..t("seconds");meterHelp.Text=t("tapHint")
    else meterTitle.Text=t("progress").." "..math.floor(value*100).."%";meterHelp.Text=t("holdHint") end
    fill.Size=UDim2.fromScale(math.clamp(value,0,1),1);fill.BackgroundColor3=state=="Resist" and C.accent or Color3.fromRGB(60,142,202)
end
local function resize()
    local size=gui.AbsoluteSize;metrics=Layout.metrics(size.X,size.Y,touch)
    panel.Size=UDim2.fromOffset(metrics.panelWidth,metrics.panelHeight)
    meter.Position=UDim2.new(.5,0,0,metrics.meterY);meter.Size=UDim2.fromOffset(metrics.meterWidth,90)
    control.Position=UDim2.fromOffset(metrics.actionX,metrics.actionY);control.Size=UDim2.fromOffset(metrics.actionW,metrics.actionH)
    cancel.Position=UDim2.fromOffset(metrics.cancelX,metrics.actionY)
    hint.Position=UDim2.new(.5,0,0,metrics.hintY);hint.Size=UDim2.fromOffset(math.min(350,size.X-24),34)
    waiting.Position=UDim2.new(.5,0,0,metrics.meterY+20);waiting.Size=UDim2.fromOffset(math.min(270,size.X-24),36)
    toast.Size=UDim2.fromOffset(math.min(370,size.X-24),size.Y<430 and 32 or 58)
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
local function hudResize()
    local h=Layout.hud(hud.AbsoluteSize.X)
    coins.Visible=h.showCoins;coins.Position=UDim2.new(0,h.coinX,.5,-22);coins.Size=UDim2.fromOffset(h.coinWidth,44)
    bag.Position=UDim2.new(0,h.bagX,.5,-22);bag.Size=UDim2.fromOffset(h.bagWidth,44)
end
hud:GetPropertyChangedSignal("AbsoluteSize"):Connect(hudResize)
GuiService.MenuOpened:Connect(function() coreMenu=true;stopInput();modal.Visible=false;toast.Visible=false;updateFishing() end)
GuiService.MenuClosed:Connect(function() coreMenu=false;updateFishing() end)
remotes:WaitForChild("FishingState").OnClientEvent:Connect(function(state)
    local previous=phase.phase;phase=state
    if state.phase=="Reel" and previous=="Waiting" then notify(t("biteNow")) end
    if state.phase=="Reel" and previous=="Resist" then notify(t("resistCleared")) end
    if state.phase=="Success" then notify(t("success").." · "..t(state.species)) elseif state.phase=="Failed" then notify(t("failed")) end
    if state.phase=="Success" or state.phase=="Failed" or state.phase=="Idle" then held=false;pointer=nil;charging=false end
    if state.phase=="Success" or state.phase=="Failed" then task.delay(2,function() if phase==state then phase={phase="Idle"};updateFishing() end end) end
    updateFishing()
end)
remotes:WaitForChild("Snapshot").OnClientEvent:Connect(function(snapshot)
    local initial=data==nil
    data=snapshot;snapshotAt=os.clock();nextAction=0
    if initial and data.saveStatus=="memory" then notify(t("memory")) end
    coins.Text=t("coins").." "..data.coins
    if quality~="none" and data.feed[quality]<1 then quality="none" end
    if selected and not data.items[selected] then selected=nil end
    context=Zones.context(position(),data.plotId);render()
end)
remotes:WaitForChild("SaveStatus").OnClientEvent:Connect(function(status)
    if data then data.saveStatus=status end
    if status=="error" then notify(t("error")) end
    if modal.Visible and tab=="help" then render() end
end)
remotes:WaitForChild("Notice").OnClientEvent:Connect(function(key) nextAction=0;notify(t(key)) end)
remotes:WaitForChild("OpenPanel").OnClientEvent:Connect(function(which) openBag(which) end)
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt;if elapsed<.15 then return end;elapsed=0
    if held and phase.phase=="Reel" and not modal.Visible and not coreMenu then Input:FireServer("hold") end
    local nextContext=Zones.context(position(),data and data.plotId)
    if nextContext~=context then context=nextContext;render() end
    local now=data and data.serverTime+os.clock()-snapshotAt or os.time()
    for _,entry in ipairs(timers) do if entry.label.Parent then entry.label.Text=t("incubating").." · "..math.max(0,math.ceil(entry.at-now))..t("seconds") end end
    updateFishing()
end)
player.CharacterAdded:Connect(function() release();phase={phase="Idle"};modal.Visible=false end)
resize();hudResize();updateFishing()
task.spawn(function() for _=1,12 do Action:FireServer("sync");if data then return end;task.wait(2) end end)
]]></string>
