      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Test balance only. No Robux or commerce integrations.
return {
    Version = "0.2.0",
    Locale = "ko",
    StudioPersistence = false, -- Explicit opt-in; separate Studio datastore namespace.
    StudioDebug = true, -- Also gated by RunService:IsStudio() on the server.
    DataStoreName = "FILAMENT_Fishing_v1",
    SchemaVersion = 1,
    StartingCoins = 100,
    InventoryLimit = 200,
    SaveAttempts = 3,
    LeaseSeconds = 180,
    RenewSeconds = 40,
    Fishing = {
        ChargeSeconds = 1.8,
        MinDistance = 8,
        MaxDistance = 38,
        FlightSeconds = 0.7,
        BiteMin = 3,
        BiteMax = 7,
        ProgressPerSecond = 0.17,
        ResistanceAt = 0.5,
        ResistanceSeconds = 4,
        ResistanceTaps = 9,
        MinTapInterval = 0.075,
        HoldLease = 0.5,
        SessionTimeout = 45,
        MaxChargeSeconds = 8,
        Cooldown = 1,
    },
    CatchTable = {
        {id = "silver", weight = 55},
        {id = "sunny", weight = 28},
        {id = "azure", weight = 12},
        {id = "tideEgg", weight = 5},
    },
    HatchSeconds = 60,
    Feed = {
        none = {duration = 60, rare = 0, legendary = 0},
        basic = {duration = 50, rare = 5, legendary = 0.5},
        premium = {duration = 40, rare = 12, legendary = 1.5},
    },
    -- Rarity rolls use these weights, not percentages added after normalization.
    HatchWeights = {common = 90, rare = 9, legendary = 1},
    HatchLevelBonus = {rare = 5, legendary = 1},
    HatchTimeBonus = {rare = 4, legendary = 0.5}, -- full 60s incubation vs sped-up egg
    Aquarium = {
        {capacity = 4, nextCost = 100},
        {capacity = 7, nextCost = 250},
        {capacity = 10, nextCost = 0},
    },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Domain</string>
          <string name="Source"><![CDATA[-- Pure game rules. No remotes, Instances, yielding, or DataStore dependencies.
local Domain = {}
function Domain.new(config, catalog, util)
    local self = {}
    function self.default()
        return {schema = config.SchemaVersion, revision = 0, coins = config.StartingCoins,
            items = {}, feed = {basic = 0, premium = 0}, aquariumLevel = 1, equippedPet = false}
    end
    function self.valid(data)
        local function integer(v, minimum, maximum)
            return type(v) == "number" and v == v and v >= minimum and v <= maximum and v % 1 == 0
        end
        if type(data) ~= "table" or data.schema ~= config.SchemaVersion then return false end
        if not integer(data.coins,0,1e12) then return false end
        if type(data.items) ~= "table" or type(data.feed) ~= "table" or not config.Aquarium[data.aquariumLevel] then return false end
        if not integer(data.revision,0,1e12) then return false end
        for _, k in ipairs({"basic", "premium"}) do
            if not integer(data.feed[k],0,1e12) then return false end
        end
        for id, item in pairs(data.items) do
            if type(id) ~= "string" or type(item) ~= "table" or item.id ~= id or not catalog[item.species] then return false end
            if item.kind ~= catalog[item.species].kind then return false end
            if item.location ~= "bag" and item.location ~= "aquarium" then return false end
            if item.kind == "pet" and item.location ~= "bag" then return false end
            if not integer(item.obtainedAt,0,1e12) then return false end
            if item.kind == "egg" and not integer(item.seed,1,2147483646) then return false end
            if item.kind == "egg" and item.location == "aquarium" then
                if not integer(item.readyAt,0,1e12) or not integer(item.startedAt,0,item.readyAt) then return false end
                if not config.Feed[item.feedQuality] or not config.Aquarium[item.incubationLevel] then return false end
            end
        end
        if data.equippedPet then
            local pet = data.items[data.equippedPet]
            if not pet or pet.kind ~= "pet" then return false end
        end
        return true
    end
    function self.grant(data, species, id, seed, now)
        if util.count(data.items) >= config.InventoryLimit then return false, "full" end
        if data.items[id] or not catalog[species] then return false, "invalid" end
        local kind = catalog[species].kind
        data.items[id] = {id = id, species = species, kind = kind, location = "bag", obtainedAt = now,
            seed = kind == "egg" and seed or nil,
            growth = kind == "fish" and {stage = 0, experience = 0, evolutionVersion = 1} or nil}
        return true, "granted"
    end
    function self.occupied(data)
        local n = 0
        for _, item in pairs(data.items) do if item.location == "aquarium" then n += 1 end end
        return n
    end
    function self.weights(level, quality, seconds)
        local f = config.Feed[quality]
        local time = math.clamp(seconds / config.HatchSeconds, 0, 1)
        return {
            {id = "otter", weight = config.HatchWeights.common},
            {id = "fox", weight = config.HatchWeights.rare + (level-1)*config.HatchLevelBonus.rare + f.rare + time*config.HatchTimeBonus.rare},
            {id = "dragon", weight = config.HatchWeights.legendary + (level-1)*config.HatchLevelBonus.legendary + f.legendary + time*config.HatchTimeBonus.legendary},
        }
    end
    function self.apply(data, action, id, option, now)
        if action == "upgrade" then
            local cost = config.Aquarium[data.aquariumLevel].nextCost
            if cost == 0 then return false, "maxLevel" end
            if data.coins < cost then return false, "noCoins" end
            data.coins -= cost
            data.aquariumLevel += 1
            return true, "upgraded"
        end
        if action == "unequip" then
            if not data.equippedPet then return false, "invalid" end
            data.equippedPet = false
            return true, "unequipped"
        end
        local item = data.items[id]
        if not item then return false, "notOwned" end
        local definition = catalog[item.species]
        if action == "place" then
            if item.location ~= "bag" or item.kind == "pet" then return false, "stateError" end
            if self.occupied(data) >= config.Aquarium[data.aquariumLevel].capacity then return false, "tankFull" end
            if item.kind == "egg" then
                local quality = option or "none"
                if not config.Feed[quality] then return false, "invalid" end
                if quality ~= "none" then
                    if data.feed[quality] < 1 then return false, "noFeed" end
                    data.feed[quality] -= 1
                end
                item.startedAt = now
                item.readyAt = now + config.Feed[quality].duration
                item.feedQuality = quality
                item.incubationLevel = data.aquariumLevel -- snapshot; upgrades affect new incubations
            end
            item.location = "aquarium"
            return true, "placed"
        elseif action == "retrieve" then
            if item.kind ~= "fish" or item.location ~= "aquarium" then return false, "eggLocked" end
            item.location = "bag"
            return true, "retrieved"
        elseif action == "sell" or action == "craft" then
            if item.kind ~= "fish" or item.location ~= "bag" then return false, "retrieveFirst" end
            if action == "sell" then data.coins += definition.value
            else
                if option ~= "basic" and option ~= "premium" then return false, "invalid" end
                local amount = option == "basic" and definition.basicYield or definition.premiumYield
                if amount == 0 then return false, "needBetterFish" end
                data.feed[option] += amount
            end
            data.items[id] = nil
            return true, action == "sell" and "sold" or "crafted"
        elseif action == "equip" then
            if item.kind ~= "pet" then return false, "invalid" end
            data.equippedPet = id
            return true, "equipped"
        end
        return false, "invalid"
    end
    function self.hatch(data, now)
        local results = {}
        for id, egg in pairs(data.items) do
            if egg.kind == "egg" and egg.location == "aquarium" and now >= egg.readyAt then
                local species = util.roll(self.weights(egg.incubationLevel, egg.feedQuality, egg.readyAt - egg.startedAt), util.seedUnit(egg.seed))
                -- Same identity becomes a pet. Removing the egg and granting the pet is one transaction.
                data.items[id] = {id = id, kind = "pet", species = species, location = "bag", obtainedAt = now,
                    originEgg = egg.species, hatchedAt = egg.readyAt, incubation = {level = egg.incubationLevel, feed = egg.feedQuality}}
                table.insert(results, species)
            end
        end
        return results
    end
    function self.buffs(data)
        local pet = data.items[data.equippedPet]
        local d = pet and catalog[pet.species]
        return d and d.biteMultiplier or 1, d and d.reelMultiplier or 1
    end
    return self
end
return Domain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">FishingMachine</string>
          <string name="Source"><![CDATA[-- Pure server-authoritative state machine; replace this for Fishing V2.
local Machine = {}
function Machine.new(config)
    local self = {}
    function self.begin(now, waitSeconds, reelMultiplier)
        return {phase = "Charge", started = now, changedAt = now, progress = 0, taps = 0,
            waitSeconds = waitSeconds, reelMultiplier = reelMultiplier, lastTap = -100, heldUntil = 0, resisted = false}
    end
    function self.input(s, action, now)
        if action == "release" and s.phase == "Charge" then
            s.power = math.clamp((now - s.started) / config.ChargeSeconds, 0, 1)
            s.phase = "Flight"
            s.changedAt = now
            return true
        elseif action == "hold" and s.phase == "Reel" then
            s.heldUntil = now + config.HoldLease
        elseif action == "stopHold" then
            s.heldUntil = 0
        elseif action == "tap" and s.phase == "Resist" and now < s.deadline and now - s.lastTap >= config.MinTapInterval then
            s.lastTap = now
            s.taps += 1
            if s.taps >= config.ResistanceTaps then
                s.resisted = true
                s.phase = "Reel"
                s.changedAt = now
                s.heldUntil = 0
            end
        end
        return false
    end
    function self.step(s, now, dt)
        if s.phase == "Success" or s.phase == "Failed" then return end
        if now - s.started > config.SessionTimeout or (s.phase == "Charge" and now-s.started > config.MaxChargeSeconds) then
            s.phase = "Failed"
            return
        end
        if s.phase == "Flight" and now - s.changedAt >= config.FlightSeconds then
            s.phase = "Waiting"
            s.changedAt = now
        elseif s.phase == "Waiting" and now - s.changedAt >= s.waitSeconds then
            s.phase = "Reel"
            s.changedAt = now
        elseif s.phase == "Reel" then
            if now <= s.heldUntil then s.progress = math.min(1, s.progress + math.min(dt, 0.15)*config.ProgressPerSecond*s.reelMultiplier) end
            if not s.resisted and s.progress >= config.ResistanceAt then
                s.progress = config.ResistanceAt
                s.phase = "Resist"
                s.deadline = now + config.ResistanceSeconds
                s.changedAt = now
                s.heldUntil = 0
            elseif s.progress >= 1 then s.phase = "Success" end
        elseif s.phase == "Resist" and now >= s.deadline then
            s.phase = "Failed"
        end
    end
    return self
end
return Machine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[local Layout={}
function Layout.metrics(w,h,touch)
    local portrait=w<600 and h>w
    local meterWidth=math.min(340,w-(touch and not portrait and 300 or 32))
    return {panelWidth=math.min(680,w-20),panelHeight=math.min(660,h-20),
        meterWidth=meterWidth,meterY=h-(touch and (portrait and 310 or 180) or 256),meterHeight=90,
        actionX=touch and w-82 or w/2-60,actionY=h-(touch and (portrait and 200 or 158) or 158),
        actionW=touch and 64 or 120,actionH=touch and 64 or 44,
        cancelX=touch and w-138 or w/2+68,hintY=h-(touch and portrait and 248 or 114),portrait=portrait}
end
function Layout.hud(width)
    local bagWidth=math.min(84,math.max(44,width-12))
    local bagX=width-bagWidth-8
    local coinWidth=math.min(136,math.max(44,bagX-16))
    return {bagX=bagX,bagWidth=bagWidth,coinX=bagX-coinWidth-8,coinWidth=coinWidth,showCoins=width>=150}
end
return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Deliberately plain test objects. Identity and ownership never live in this model.
local Models={}
function Models.make(kind,species,rgb)
    local m=Instance.new("Model");m.Name=species
    local p=Instance.new("Part");p.Name="Body";p.Shape=Enum.PartType.Ball
    p.Size=kind=="fish" and Vector3.new(1,1,2) or (kind=="egg" and Vector3.new(1.4,1.8,1.4) or Vector3.new(1.5,1.5,1.5))
    p.Color=Color3.fromRGB(unpack(rgb));p.Material=Enum.Material.SmoothPlastic
    p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=m;m.PrimaryPart=p
    return m
end
return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Presentation</string>
          <string name="Source"><![CDATA[-- Minimal view rules; no inventory mutation or reward decision on the client.
local P={}
function P.view(phase,equipped,atDock,modal)
    local active=phase=="Charge" or phase=="Reel" or phase=="Resist"
    return {meter=not modal and active,hint=not modal and equipped and phase=="Idle",
        action=not modal and equipped and ((phase=="Idle" and atDock) or active),
        waiting=not modal and (phase=="Waiting" or phase=="Flight" or phase=="Saving"),
        cancel=not modal and (active or phase=="Waiting" or phase=="Flight")}
end
function P.intent(phase,held)
    if held then return nil end
    return ({Idle="start",Reel="hold",Resist="tap"})[phase]
end
function P.actions(item,context,equipped,catalog)
    if item.kind=="pet" then return {item.id==equipped and "unequip" or "equip"} end
    if item.location=="aquarium" then return item.kind=="fish" and context=="aquarium" and {"retrieve"} or {} end
    if context=="aquarium" then return {"place"} end
    if item.kind=="fish" and context=="shop" then return {"sell"} end
    if item.kind=="fish" and context=="craft" then
        return catalog[item.species].premiumYield>0 and {"craftBasic","craftPremium"} or {"craftBasic"}
    end
    return {}
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Strings</string>
          <string name="Source"><![CDATA[-- All interface copy lives here. Add a locale table without rewriting UI logic.
local ko = {
    title="FILAMENT · FISHING", coins="코인", inventory="가방", fish="물고기", eggs="알", pets="펫", tank="수족관", help="도움말",
    silver="은빛 피라미",sunny="햇살 농어",azure="푸른 잉어",tideEgg="물결 알",otter="아기 수달",fox="구름 여우",dragon="별빛 드래곤",
    common="일반",uncommon="고급",rare="희귀",legendary="전설",basic="기본 사료",premium="고급 사료",none="사료 없음",
    dock="낚시터",aquarium="내 수족관",shop="판매 상점",craft="사료 공방",close="닫기",language="EN",rod="낚싯대 장착",
    idle="부두에서 낚시를 시작하세요",charge="놓으면 캐스팅!",flight="찌가 날아갑니다",waiting="입질을 기다리는 중…",reel="누르고 유지해서 끌어올리세요",resist="저항! 빠르게 여러 번 누르세요",success="포획 성공!",failed="물고기가 도망갔습니다",savingCatch="획득 정보를 저장하는 중…",
    castButton="길게 누르기 · 캐스팅",reelButton="길게 누르기 · 끌어올리기",tapButton="연타!",waitingButton="기다려 주세요",cancel="취소",power="캐스팅 파워",progress="포획 진행",resistance="저항 제거",keyHint="PC: F 또는 화면 버튼 / 모바일: 화면 버튼",
    place="수조 배치",retrieve="회수",sell="판매",craftBasic="기본 사료 제작",craftPremium="고급 사료 제작",equip="장착",unequip="해제",equippedLabel="장착 중",bag="가방",inTank="수조 안",incubating="부화 중",ready="부화 처리 중",empty="아직 개체가 없습니다. 낚시로 수집해 보세요.",
    upgrade="수족관 업그레이드",level="레벨",capacity="배치",maxLevel="최대 레벨입니다",feedChoice="알 배치 시 사용할 사료",lockedEgg="부화가 시작된 알은 회수할 수 없습니다",probabilities="부화 예상 확률",snapshotted="배치 시 사료·수조 레벨이 확정됩니다",buff="장착 버프",noPet="장착한 펫 없음",bite="입질 대기",efficiency="포획 효율",seconds="초",price="판매가",
    memory="임시 저장 · Stop 시 초기화",saved="클라우드 저장 완료",saving="저장 중…",error="저장 실패 · 세션 중지",loading="데이터 불러오는 중…",
    granted="아이템을 획득했습니다",placed="수족관에 배치했습니다",retrieved="가방으로 회수했습니다",sold="판매했습니다",crafted="사료를 만들었습니다",upgraded="수족관 레벨이 올랐습니다",equipped="펫을 장착했습니다",unequipped="펫을 해제했습니다",hatched="알이 부화했습니다! 펫 탭을 확인하세요",debugDone="Studio 테스트 데이터를 적용했습니다",
    full="가방이 가득 찼습니다 (최대 200개)",invalid="올바르지 않은 요청입니다",noCoins="코인이 부족합니다",notOwned="본인이 소유한 개체가 아닙니다",stateError="이 상태에서는 사용할 수 없습니다",tankFull="수족관이 가득 찼습니다. 회수하거나 업그레이드하세요",noFeed="선택한 사료가 부족합니다",eggLocked="부화 중인 알은 회수할 수 없습니다",retrieveFirst="수조의 물고기는 먼저 회수하세요",needBetterFish="이 물고기는 고급 사료로 만들 수 없습니다",notReady="아직 준비되지 않았습니다",busy="저장 작업 중입니다. 잠시 뒤 다시 눌러 주세요",serverError="처리 중 오류가 발생했습니다. Output을 확인해 주세요",saveError="저장에 실패했습니다",finishFishing="낚시를 마치거나 취소해 주세요",
    goDock="낚싯대를 장착하고 부두 위로 이동해 주세요",goAquarium="내 수족관으로 이동해 주세요",goShop="판매 상점으로 이동해 주세요",goCraft="사료 공방으로 이동해 주세요",
    helpBody="1. [낚시터]를 누르면 부두로 이동합니다.\n2. F키 또는 캐스팅 버튼을 누르다가 놓으세요.\n3. 입질 후 버튼을 유지해 게이지를 채우세요.\n4. 저항 구간에서는 버튼을 놓고 4초 안에 9번 연타하세요.\n5. 다시 유지하면 물고기나 희귀 알을 획득합니다.\n6. 가방을 열고 내 수족관·상점·공방으로 이동해 활용하세요.\n7. 알은 사료를 선택하고 수조에 배치하면 40~60초 뒤 부화합니다.\n8. 펫 탭에서 장착하면 대기시간과 포획 속도가 실제로 바뀝니다.\n\n물고기와 알에서 부화하는 동물 펫은 별개입니다.\nStudio 임시 모드에서는 Stop 시 모든 데이터가 초기화됩니다.\n클라우드 저장은 README의 비공개 저장 테스트 절차를 따라 주세요.",
